+#elif A5_BOARD_SEL_DREAMLTE
+#define DREAMLTE                      1
+#endif
+
+#if A5_BOARD_SEL_EXYNOS990
+/*
+ * Exynos 990 board facts.
+ *
+ * SoC: Exynos 990 (universal9830), Cortex-A55 x4 + Cortex-A76 x2 +
+ * Exynos M5 x2, GIC-400, 26 MHz architected timer, UFS 3.0 at
+ * 0x13100000, USI debug UART at 0x10540000, DECON/DSIM display.
+ *
+ * The Exynos GIC implements only the 16 local SGIs, so its PPI window
+ * starts at INTID 16: PPI n is INTID 16 + n.  The physical timer is
+ * PPI 14 = INTID 30 (the A5XELTE port used INTID 27 for the Exynos 7580
+ * PPI 11, the S8 port INTID 30 for the Exynos 8895 PPI 14).  The EL1
+ * virtual timer does not reach the secondary cores on Exynos, so the
+ * physical timer is used.
+ *
+ * The board facts that are not known yet are set to "off" instead of to
+ * a guess: the DECON handoff does not exist for this SoC yet, so there is
+ * no framebuffer (A5_FB_PHYS 0 compiles out every framebuffer writer),
+ * no log RAM address and no keys or touch controller.  The loader prints
+ * the real boot MPIDR and the log sink address is read off the phone
+ * (see EXYNOS990_PROGRESS.md).
+ */
+#define A5_FB_PHYS                    0           /* no DECON handoff yet */
+#define A5_FB_WIDTH                   1440
+#define A5_FB_HEIGHT                  3200
+#define A5_FB_STRIDE                  5760        /* bytes per row */
+#define A5_FB_2M_BLOCKS               0
+#define A5_ENTRY_MARKER_PHYS          0           /* no log RAM known yet */
+#define A5_BOOT_MPIDR                 0           /* TBC: the loader prints it */
+#define A5_KEYS_DEFAULT               0           /* per-model GPIO keys unknown */
+#define A5_TOUCH_DEFAULT              0           /* no 990 touch controller yet */
+#define A5_KLOG_PHYS                  0           /* TBC: TWRP pmsg address */
+#define A5_KLOG_SIZE                  0x80000
+#define A5_USE_PHYS_TIMER             1
+#undef A5XELTE_VTIMER_INTID
+#define A5XELTE_VTIMER_INTID         30
+/* Exynos 990 system controller (pmu_system_controller in exynos9830.dts). */
+#define A5_PMU_BASE                   0x15860000
+/* Exynos 990 pinctrl ALIVE (pinctrl_0 in exynos9830.dts). */
+#define A5_ALIVE_PA                   0x15850000
+#elif A5_BOARD_SEL_DREAMLTE
 /*
  * Samsung Galaxy S8 (SM-G950F, dreamlte, Exynos 8895) build of this port.
  * Same Samsung S-Boot handoff, GIC-400, 26 MHz timer and Cortex-A53 boot
  * cluster as the A5; the board facts that differ are below.
  */
-#define DREAMLTE                      1
-#if defined(DREAMLTE)
 #define A5_FB_PHYS                    0xcc000000  /* s3cfb.bootloaderfb */
 #define A5_FB_WIDTH                   1440
 #define A5_FB_HEIGHT                  2960
@@ -49,6 +119,10 @@
 #define A5_USE_PHYS_TIMER             1
 #undef A5XELTE_VTIMER_INTID
 #define A5XELTE_VTIMER_INTID         30
+/* Exynos 8895 system controller (pmu in exynos8895.dts). */
+#define A5_PMU_BASE                   0x16480000
+/* Exynos 8895 pinctrl ALIVE. */
+#define A5_ALIVE_PA                   0x164b0000
 #else
 #define A5_FB_PHYS                    0x67000000
 #define A5_FB_WIDTH                   1080
@@ -59,6 +133,27 @@
 #define A5_BOOT_MPIDR                 0
 #define A5_KEYS_DEFAULT               1
 #define A5_TOUCH_DEFAULT              1
+#define A5_PMU_BASE                   0           /* unused on the A5 */
+#define A5_ALIVE_PA                   0x139b0000  /* Exynos 7580 pinctrl ALIVE */
+#endif
+
+/* A framebuffer exists only when the board has a scanout buffer to draw
+ * on; the Exynos 990 has no DECON handoff yet, so A5_FB_PHYS is 0 there
