@@ -752,10 +752,16 @@ klog_init(void)
 		return;
 	}
 	klog_data = (volatile uint8_t *)(klog_hdr + 3);
-	/* Continue after the loader's text if its header is sane. */
-	if (klog_hdr[0] == 0x43474244u && klog_hdr[1] == klog_hdr[2] &&
-	    klog_hdr[2] < KLOG_CAP - 0x10000) {
-		klog_start = klog_size = klog_hdr[2];
+	/* Continue after the loader's text if its header is sane.  Only an
+	 * unfull ring has start == size (persistent_ram semantics); a full
+	 * one is restarted at the beginning of the data area instead of
+	 * indexing past its end. */
+	uint32_t start = klog_hdr[1];
+	uint32_t size = klog_hdr[2];
+	if (klog_hdr[0] == 0x43474244u && start < KLOG_CAP &&
+	    size <= KLOG_CAP && (size == KLOG_CAP || start == size)) {
+		klog_start = (size == KLOG_CAP) ? 0 : start;
+		klog_size = size;
 	} else {
 		klog_hdr[0] = 0x43474244u;
 		klog_start = klog_size = 0;
