Subject: [PATCH] exynos990: step marks in the page-table walk

The first version wrote nothing at all, and the reason may be the
instrument rather than the walk: the log text grows from offset 0 and the
stage bytes live at +0x800, so a long enough text overwrites the very byte
it just set.  This version marks every step, so the absence of a mark
localises the fault:
    50        block entered
    54/62/70/78   about to read the L1 entry (cpu/cpu, cpu/boot, boot/cpu, boot/boot)
    +1        L1 entry read
    +2        about to read the L2 entry
    +3        L2 entry read
    +4        about to read the L3 entry
    +5        mapped (valid block or page)
If 50 is missing the block never ran; if 54 is present and 55 is not, the
very first table read through the live TTBR1 faults.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2309,5 +2309,52 @@
 	sweet_early_mark(41, "ttbr0 switch deferred");
+	{
+		tt_entry_t  *ttbs[2];
+		vm_offset_t  vas[2];
+		int t, v, base;
+
+		ttbs[0] = cpu_tte;
+		ttbs[1] = boot_tte;
+		vas[0] = (vm_offset_t)(uintptr_t)&arm_vm_init;
+		vas[1] = (vm_offset_t)(uintptr_t)&cpu_ttep;
+
+		sweet_early_mark(50, "pt walk probe entered");
+
+		for (t = 0; t < 2; t++) {
+			for (v = 0; v < 2; v++) {
+				tt_entry_t *l1;
+				tt_entry_t e, e2;
+
+				base = 54 + (t * 2 + v) * 8;
+				sweet_early_mark(base, "L1 read");
+				l1 = ttbs[t] + L1_TABLE_INDEX(vas[v]);
+				e = *l1;
+				sweet_early_mark(base + 1, "L1 ok");
+
+				if ((e & ARM_TTE_VALID) != 0 &&
+				    (e & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_BLOCK) {
+					tt_entry_t *l2 = L2_TABLE_VA(l1);
+
+					sweet_early_mark(base + 2, "L2 read");
+					e2 = l2[L2_TABLE_INDEX(vas[v])];
+					sweet_early_mark(base + 3, "L2 ok");
+					if ((e2 & ARM_TTE_VALID) != 0 &&
+					    (e2 & ARM_TTE_TYPE_MASK) != ARM_TTE_TYPE_BLOCK) {
+						pt_entry_t *l3 = L3_TABLE_VA(l2 + L2_TABLE_INDEX(vas[v]));
+
+						sweet_early_mark(base + 4, "L3 read");
+						if (l3[L3_TABLE_INDEX(vas[v])] != ARM_PTE_EMPTY) {
+							sweet_early_mark(base + 5, "mapped");
+						}
+					} else if ((e2 & ARM_TTE_VALID) != 0) {
+						sweet_early_mark(base + 5, "mapped");
+					}
+				} else if ((e & ARM_TTE_VALID) != 0) {
+					sweet_early_mark(base + 5, "mapped");
+				}
+			}
+		}
+	}
 
 	flush_mmu_tlb();
 	sweet_early_mark(10, "TTBR0 kept; TLB flushed");
 	kva_active = TRUE;
