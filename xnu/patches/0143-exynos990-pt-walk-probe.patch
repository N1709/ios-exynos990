Subject: [PATCH] exynos990: walk cpu_ttep and boot_tte by hand before the flush

Every mark up to 41 is written while the TLB still holds translations from
the bootstrap tables, so their success says nothing about the table that is
about to become live.  Mark 10, the first store after flush_mmu_tlb(), never
happens.  Walk both tables in software, before the flush, and report where
the walk stops instead of guessing:

  50..53  cpu_tte  &arm_vm_init   ok / L1 / L2 / L3 invalid
  54..57  cpu_tte  &cpu_ttep
  58..61  boot_tte &arm_vm_init
  62..65  boot_tte &cpu_ttep

A valid BLOCK descriptor at L1 or L2 counts as mapped, a table pointer
outside the RAM window is reported as 4 instead of being dereferenced, and
the walk uses the same granule-selected macros the kernel itself uses
(L1_TABLE_INDEX, L2_TABLE_VA, L3_TABLE_VA), so it is correct for 4K and
16K pages alike.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2309,5 +2309,51 @@
 	sweet_early_mark(41, "ttbr0 switch deferred");
+	{
+		pmap_paddr_t ram_lo = gPhysBase;
+		pmap_paddr_t ram_hi = gPhysBase + memory_size;
+		tt_entry_t  *ttbs[2];
+		vm_offset_t  vas[2];
+		int t, v;
+
+		ttbs[0] = cpu_tte;
+		ttbs[1] = boot_tte;
+		vas[0] = (vm_offset_t)(uintptr_t)&arm_vm_init;
+		vas[1] = (vm_offset_t)(uintptr_t)&cpu_ttep;
+
+		for (t = 0; t < 2; t++) {
+			for (v = 0; v < 2; v++) {
+				tt_entry_t *l1 = ttbs[t] + L1_TABLE_INDEX(vas[v]);
+				tt_entry_t  e = *l1;
+				int res;
+
+				if ((e & ARM_TTE_VALID) == 0) {
+					res = 1;
+				} else if ((e & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+					res = 0;
+				} else if (((e & ARM_TTE_TABLE_MASK) < ram_lo) ||
+				    ((e & ARM_TTE_TABLE_MASK) >= ram_hi)) {
+					res = 4;
+				} else {
+					tt_entry_t *l2 = L2_TABLE_VA(l1);
+					tt_entry_t  e2 = l2[L2_TABLE_INDEX(vas[v])];
+
+					if ((e2 & ARM_TTE_VALID) == 0) {
+						res = 2;
+					} else if ((e2 & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+						res = 0;
+					} else if (((e2 & ARM_TTE_TABLE_MASK) < ram_lo) ||
+					    ((e2 & ARM_TTE_TABLE_MASK) >= ram_hi)) {
+						res = 4;
+					} else {
+						pt_entry_t *l3 = L3_TABLE_VA(l2 + L2_TABLE_INDEX(vas[v]));
+
+						res = (l3[L3_TABLE_INDEX(vas[v])] != ARM_PTE_EMPTY) ? 0 : 3;
+					}
+				}
+				sweet_early_mark(50 + (t * 2 + v) * 4 + res, "pt walk probe");
+			}
+		}
+	}
 
 	flush_mmu_tlb();
 	sweet_early_mark(10, "TTBR0 kept; TLB flushed");
 	kva_active = TRUE;
