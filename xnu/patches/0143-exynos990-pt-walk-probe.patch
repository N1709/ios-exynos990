Subject: [PATCH] exynos990: walk cpu_ttep by hand before the flush

Every mark up to 41 is written while the TLB still holds translations from
the bootstrap tables, so their success says nothing about the table that
is about to become live.  Mark 10, the first store after flush_mmu_tlb(),
never happens.  Walk both tables in software, before the flush, and report
where the walk stops instead of guessing:

  50..53  cpu_ttep  &sweet_early_mark   ok / L1 / L2 / L3 invalid
  54..57  cpu_ttep  &cpu_ttep
  58..61  boot_ttep &sweet_early_mark
  62..65  boot_ttep &cpu_ttep

A valid BLOCK descriptor at L1 or L2 counts as mapped, and a table pointer
outside the RAM window is reported as 4 instead of being dereferenced, so
the probe cannot fault on a garbage descriptor.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -2309,5 +2309,52 @@
 	sweet_early_mark(41, "ttbr0 switch deferred");
+	{
+		pmap_paddr_t ram_lo = gPhysBase;
+		pmap_paddr_t ram_hi = gPhysBase + memory_size;
+		pmap_paddr_t ttbs[2];
+		vm_offset_t  vas[2];
+		int t, v;
+
+		ttbs[0] = cpu_ttep;
+		ttbs[1] = boot_ttep;
+		vas[0] = (vm_offset_t)(uintptr_t)&sweet_early_mark;
+		vas[1] = (vm_offset_t)(uintptr_t)&cpu_ttep;
+
+		for (t = 0; t < 2; t++) {
+			for (v = 0; v < 2; v++) {
+				tt_entry_t *tab = (tt_entry_t *)phystokv(ttbs[t]);
+				tt_entry_t e = tab[L1_TABLE_T1_INDEX(vas[v], TCR_EL1_BOOT)];
+				int res;
+
+				if ((e & ARM_TTE_VALID) == 0) {
+					res = 1;
+				} else if ((e & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+					res = 0;
+				} else if (((e & ARM_TTE_TABLE_MASK) < ram_lo) ||
+				    ((e & ARM_TTE_TABLE_MASK) >= ram_hi)) {
+					res = 4;
+				} else {
+					tt_entry_t *l2 = (tt_entry_t *)phystokv(e & ARM_TTE_TABLE_MASK);
+					tt_entry_t e2 = l2[(vas[v] & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+
+					if ((e2 & ARM_TTE_VALID) == 0) {
+						res = 2;
+					} else if ((e2 & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+						res = 0;
+					} else if (((e2 & ARM_TTE_TABLE_MASK) < ram_lo) ||
+					    ((e2 & ARM_TTE_TABLE_MASK) >= ram_hi)) {
+						res = 4;
+					} else {
+						tt_entry_t *l3 = (tt_entry_t *)phystokv(e2 & ARM_TTE_TABLE_MASK);
+						tt_entry_t e3 = l3[(vas[v] & ARM_TT_L3_INDEX_MASK) >> ARM_TT_L3_SHIFT];
+
+						res = ((e3 & ARM_TTE_VALID) != 0) ? 0 : 3;
+					}
+				}
+				sweet_early_mark(50 + (t * 2 + v) * 4 + res, "pt walk probe");
+			}
+		}
+	}
 
 	flush_mmu_tlb();
 	sweet_early_mark(10, "TTBR0 kept; TLB flushed");
 	kva_active = TRUE;
