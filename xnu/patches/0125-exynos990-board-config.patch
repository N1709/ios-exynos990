-		*(uint32_t *)data = emmc_writable ? 1 : 0;
-		return 0;
-	case DKIOCGETMAXBLOCKCOUNTREAD:
-		*(uint64_t *)data = 1;
-		return 0;
-	case DKIOCGETMAXBLOCKCOUNTWRITE:
-		*(uint64_t *)data = emmc_writable ? 1 : 0;
