@@ -0,0 +1,88 @@
+/* Samsung Galaxy S20 family, Exynos 990 (universal9830).
+ *
+ * Board header of this port.  It is a separate machine config
+ * (ARM64_BOARD_CONFIG_EXYNOS990) and not a variant of the A5 donor
+ * header; the shared constants carry the neutral SWEET_* names.
+ *
+ * SoC: Exynos 990 (universal9830), Cortex-A55 x4 + Cortex-A76 x2 +
+ * Exynos M5 x2, GIC-400, 26 MHz architected timer, UFS 3.0 at
+ * 0x13100000, USI debug UART at 0x10540000, DECON/DSIM display.
+ *
+ * The Exynos GIC implements only the 16 local SGIs, so its PPI window
+ * starts at INTID 16: PPI n is INTID 16 + n.  The physical timer is
+ * PPI 14 = INTID 30 (the A5XELTE port used INTID 27 for the Exynos 7580
+ * PPI 11, the S8 port INTID 30 for the Exynos 8895 PPI 14).  The EL1
+ * virtual timer does not reach the secondary cores on Exynos, so the
+ * physical timer is used.
+ *
+ * The board facts that are not known yet are set to "off" instead of to
+ * a guess: the DECON handoff does not exist for this SoC yet, so there is
+ * no framebuffer (SWEET_FB_PHYS 0 compiles every framebuffer writer
+ * out), no log RAM address and no keys or touch controller.  The loader
+ * prints the real boot MPIDR and the log sink address is read off the
+ * phone (see EXYNOS990_PROGRESS.md).
+ */
+#ifndef _PEXPERT_ARM64_EXYNOS990_H
+#define _PEXPERT_ARM64_EXYNOS990_H
+
+#define EXYNOS990                     1
+#define NO_MONITOR                    1
+#define NO_ECORE                      1
+/* Reuse donor's SoC-neutral early services until their guards are renamed. */
+#define SWEET                         1
+#define SWEET_SMP_MAX_CPUS            8
+
+#define ARM_ARCH_TIMER
+#define __ARM_ARCH__                  8
+#define __ARM_VMSA__                  8
+#define __ARM_VFP__                   4
+#define __ARM_COHERENT_CACHE__        1
+#define __ARM_DEBUG__                 7
+#define __ARM_ENABLE_SWAP__           1
+#define __ARM_V8_CRYPTO_EXTENSIONS__  1
+#define __ARM_PAN_AVAILABLE__         0
+
+/* Exynos GICv2 distributor and CPU interface, not GICv3. */
+#define HAS_GIC_V3                    0
+
+#define SWEET_FB_PHYS                 0           /* no DECON handoff yet */
+#define SWEET_FB_WIDTH                1440
+#define SWEET_FB_HEIGHT               3200
+#define SWEET_FB_STRIDE               5760        /* bytes per row */
+#define SWEET_FB_2M_BLOCKS            0
+#define SWEET_ENTRY_MARKER_PHYS       0           /* no log RAM known yet */
+#define SWEET_BOOT_MPIDR              0           /* TBC: the loader prints it */
+#define SWEET_KEYS_DEFAULT            0           /* per-model GPIO keys unknown */
+#define SWEET_TOUCH_DEFAULT           0           /* no 990 touch controller yet */
+#define SWEET_KLOG_PHYS               0           /* TBC: TWRP pmsg address */
+#define SWEET_KLOG_SIZE               0x80000
+#define SWEET_USE_PHYS_TIMER          1
+/* Physical timer: PPI 14 = INTID 30 (see the comment above). */
+#define SWEET_VTIMER_INTID            30
+/* Exynos 990 system controller (pmu_system_controller in exynos9830.dts). */
+#define SWEET_PMU_BASE                0x15860000
+/* Exynos 990 pinctrl ALIVE (pinctrl_0 in exynos9830.dts). */
+#define SWEET_ALIVE_BASE              0x15850000
+
+/* A framebuffer exists only when the board has a scanout buffer to draw
+ * on.  A klog sink exists only when its RAM address is known. */
+#if (SWEET_FB_PHYS) != 0
+#define SWEET_HAS_FB                  1
+#else
+#define SWEET_HAS_FB                  0
+#endif
+#ifdef SWEET_KLOG_PHYS
+#if (SWEET_KLOG_PHYS) != 0
+#define SWEET_HAS_KLOG                1
+#else
+#define SWEET_HAS_KLOG                0
+#endif
+#else
+#define SWEET_HAS_KLOG                0
+#endif
+
+#ifndef ASSEMBLER
+#define PLATFORM_PANIC_LOG_DISABLED
+#endif
+
+#endif /* _PEXPERT_ARM64_EXYNOS990_H */
