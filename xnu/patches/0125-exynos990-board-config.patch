-/* _cnputs may execute in any context. Keep this path free of locks and I/O. */
-void a5xelte_log_append(const char *c, int size);
-void
-a5xelte_log_append(const char *c, int size)
-{
-	if (size <= 0) {
-		return;
-	}
-	uint64_t at = os_atomic_add_orig(&emmc_log_total, (uint64_t)size, relaxed);
-	for (int i = 0; i < size; i++) {
-		emmc_log_ring[(at + (uint64_t)i) % A5_LOG_SIZE] = c[i];
-	}
-}
-
-struct a5_log_header {
-	char magic[8];
-	uint32_t version, size;
-	uint64_t total, seq;
-};
-
-static void
-emmc_log_thread(__unused void *arg, __unused wait_result_t wr)
-{
-	uint64_t flushed = 0, seq = 0;
-	uint8_t sector[512];
-	for (;;) {
-		(void)tsleep(&emmc_log_chan, PZERO, "a5log", hz * 10);
-		uint64_t total = os_atomic_load(&emmc_log_total, relaxed);
-		if (total == flushed) {
-			continue;
-		}
-		uint64_t pos = total - flushed >= A5_LOG_SIZE ? total - A5_LOG_SIZE : flushed;
-		int error = 0;
-		lck_mtx_lock(&a5xelte_emmc_lock);
-		while (pos < total && !error) {
-			uint32_t block = (uint32_t)((pos % A5_LOG_SIZE) / 512u);
-			uint64_t lba = emmc_log_first_lba + 1u + block;
-			if (lba >= emmc_log_first_lba + A5_LOG_SECTORS || lba > UINT32_MAX) {
-				error = EINVAL;
-				break;
-			}
-			memcpy(sector, emmc_log_ring + (size_t)block * 512u, 512u);
-			error = emmc_write_sector((uint32_t)lba, sector);
-			pos += 512u - (pos & 511u);
-		}
-		if (!error) {
-			struct a5_log_header h = {
-				.magic = { 'A', '5', 'X', 'L', 'O', 'G', '1', '\0' },
-				.version = 1, .size = A5_LOG_SIZE, .total = total, .seq = ++seq,
-			};
-			memset(sector, 0, sizeof(sector));
-			memcpy(sector, &h, sizeof(h));
-			error = emmc_write_sector((uint32_t)emmc_log_first_lba, sector);
-		}
-		lck_mtx_unlock(&a5xelte_emmc_lock);
-		if (error) {
-			printf("A5XELTE LOG: write failed (%d), stopping\n", error);
-			return;
-		}
-		flushed = total;
-	}
-}
-
-static void
-emmc_log_start(void)
-{
-	int enabled = 0;
-	thread_t thread;
-	(void)PE_parse_boot_argn("a5log", &enabled, sizeof(enabled));
-	if (enabled != 1 || !emmc_ready || !emmc_writable ||
-	    strcmp(emmc_partition_name, "USERDATA") ||
-	    emmc_log_nsectors < A5_LOG_SECTORS ||
-	    emmc_log_first_lba == 0 ||
-	    (emmc_log_first_lba < emmc_first_lba + emmc_nsectors &&
-	    emmc_first_lba < emmc_log_first_lba + A5_LOG_SECTORS) ||
-	    emmc_log_first_lba + A5_LOG_SECTORS - 1 > UINT32_MAX) {
-		return;
-	}
-	emmc_log_enabled = true;
-	printf("A5XELTE LOG: SYSTEM GPT first=%llu, %u sectors reserved\n",
-	    emmc_log_first_lba, A5_LOG_SECTORS);
-	if (kernel_thread_start(emmc_log_thread, NULL, &thread) == KERN_SUCCESS) {
-		thread_deallocate(thread);
-	} else {
-		emmc_log_enabled = false;
-	}
-}
-
-int
-a5xelte_emmc_rootdev(dev_t *dev)
-{
-	if (!emmc_ready) {
-		int error = emmc_map_host();
-		if (error) {
-			return error;
-		}
-		error = emmc_find_root_partition();
-		if (error) {
-			return error;
-		}
-		int bmajor = bdevsw_add(-1, &emmc_bdevsw);
-		if (bmajor < 0) {
-			return ENXIO;
-		}
-		int cmajor = cdevsw_add_with_bdev(-1, &emmc_cdevsw, bmajor);
-		if (cmajor < 0) {
-			return ENXIO;
-		}
-		emmc_bdev = makedev(bmajor, 0);
-		devfs_make_node(emmc_bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "emmcroot0");
-		devfs_make_node(makedev(cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "remmcroot0");
-		emmc_ready = true;
-		printf("A5XELTE eMMC: /dev/emmcroot0 ready, GPT %s %s\n",
-		    emmc_partition_name, emmc_writable ? "writable" : "read-only");
-		emmc_log_start();
-	}
-	*dev = emmc_bdev;
-	return 0;
-}
-#endif /* ARM64_BOARD_CONFIG_A5XELTE */
diff --git a/bsd/dev/a5xelte_keys.c b/bsd/dev/a5xelte_keys.c
deleted file mode 100644
index dcbd143..0000000
--- a/bsd/dev/a5xelte_keys.c
+++ /dev/null
@@ -1,132 +0,0 @@
-/*
- * Exynos7580 ALIVE GPIO keys for the SM-A510F.
- *
- * The working Linux device tree locates Power/Volume Up/Volume Down/Home at
- * GPA2 pins 7/0/1/5, all active low.  Poll only GPA2DAT; boot firmware owns
- * the pin mux and pull-ups.  No ALIVE or interrupt-controller writes occur.
- */
-#if defined(ARM64_BOARD_CONFIG_A5XELTE)
-#include <sys/param.h>
-#include <sys/systm.h>
-#include <kern/clock.h>
-#include <kern/thread.h>
-#include <kern/sched_prim.h>
-#include <machine/machine_routines.h>
-#include <pexpert/pexpert.h>
-#include <pexpert/arm64/board_config.h>
-
-extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
-extern void sweet_hid_key(int key, int down);
-
-#if defined(DREAMLTE)
-#define A5_ALIVE_PA 0x164b0000u            /* Exynos 8895 pinctrl ALIVE */
-#else
-#define A5_ALIVE_PA 0x139b0000u
-#endif
-#define A5_GPA2_CON 0x40u
-#define A5_GPA2_DAT 0x44u
-#define A5_GPA2_PUD 0x48u
-
-static vm_offset_t a5_alive;
-static int a5_keys_sleep;
-static bool a5_keys_started;
-
-static uint32_t
-a5_keys_read(uint32_t offset)
-{
-	uint32_t value = *(volatile uint32_t *)(a5_alive + offset);
-	__asm__ volatile("dmb oshld" ::: "memory");
-	return value;
-}
-
-#if defined(DREAMLTE)
-/*
- * Galaxy S8 (mainline exynos8895-dreamlte.dts gpio-keys, all active low):
- * Power GPA2-4, Volume Up GPA0-3, Volume Down GPA0-4, Bixby GPA0-6 (used
- * as Home). Bank offsets per mainline pinctrl-exynos-arm64.c
- * (exynos8895_pin_banks0): GPA0 0x020, GPA2 0x060; DAT at +4. Boot 22/23
- * read 0x044 (GPA1 DAT) and saw nothing. Sample = GPA0 | GPA2 << 8.
- */
-typedef uint16_t keys_t;
-#define KEYS_SAMPLE() ((keys_t)((a5_keys_read(0x24) & 0xff) | (a5_keys_read(0x64) & 0xff) << 8))
-#define KEYS_PINS { 12, 3, 4, 6 }
-#else
-typedef uint8_t keys_t;
-#define KEYS_SAMPLE() ((keys_t)a5_keys_read(A5_GPA2_DAT))
-#define KEYS_PINS { 7, 0, 1, 5 }
-#endif
-
-static void
-a5_keys_wait(void)
-{
-	uint64_t deadline;
-	clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
-	(void)assert_wait_deadline(&a5_keys_sleep, THREAD_UNINT, deadline);
-	thread_block(THREAD_CONTINUE_NULL);
-}
-
-static void
-a5_keys_thread(void *arg, wait_result_t result)
-{
-	static const uint8_t pins[4] = KEYS_PINS;
-	keys_t stable = KEYS_SAMPLE();
-	keys_t previous = stable;
-	unsigned repeated = 0;
-	(void)arg;
-	(void)result;
-	for (;;) {
-		keys_t sample = KEYS_SAMPLE();
-		if (sample == previous) {
-			if (repeated < 2) {
-				repeated++;
-			}
-		} else {
-			previous = sample;
-			repeated = 0;
-		}
-		if (repeated == 2 && stable != sample) {
-			for (unsigned key = 0; key < 4; key++) {
-				keys_t bit = (keys_t)(1u << pins[key]);
-				if ((stable ^ sample) & bit) {
-					int down = !(sample & bit);
-					printf("A5XELTE KEYS: key=%u down=%d gpio=%#x\n",
-					    key, down, sample);
-					sweet_hid_key((int)key, down);
-				}
-			}
-			stable = sample;
-		}
-		a5_keys_wait();
-	}
-}
-
-void
-a5xelte_keys_init(void)
-{
-	thread_t thread;
-	int enabled = A5_KEYS_DEFAULT;
-	if (a5_keys_started) {
-		return;
-	}
-	a5_keys_started = true;
-	(void)PE_parse_boot_argn("a5keys", &enabled, sizeof(enabled));
-	if (!enabled) {
-		printf("A5XELTE KEYS: disabled\n");
-		return;
-	}
-	a5_alive = ml_io_map(A5_ALIVE_PA, 0x1000);
-	if (!a5_alive) {
-		printf("A5XELTE KEYS: ALIVE mapping failed\n");
-		return;
-	}
-	printf("A5XELTE KEYS: GPA2 con=%#x dat=%#x pud=%#x (read only)\n",
-	    a5_keys_read(A5_GPA2_CON), a5_keys_read(A5_GPA2_DAT),
-	    a5_keys_read(A5_GPA2_PUD));
-	kern_return_t kr = kernel_thread_start(a5_keys_thread, NULL, &thread);
-	if (kr == KERN_SUCCESS) {
-		thread_deallocate(thread);
-	} else {
-		printf("A5XELTE KEYS: thread start failed %d\n", kr);
-	}
-}
-#endif
