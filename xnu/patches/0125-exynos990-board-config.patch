-#if defined(DREAMLTE)
-/*
- * Galaxy S8 I2C devices, polled (no XNU interrupt routing for them).
- * The loader (shim/dreamlte) ungates both USI blocks with their clock on
- * OSCCLK, sets USI v1 I2C mode and the pins, and powers the touch rails.
- *
- * Touch: Samsung S6SY761 at 0x48 on hsi2c_23 (USI09, 0x108e0000), its
- * interrupt gpa1-0 active low (boot 26: boot status 0x20, device id
- * 0xac3761). Event protocol from mainline s6sy761.c; raw 0..4095 axes go
- * to SweetHIDTouch's 1080x1920 grid.
- *
- * Battery: MAX77865 on hsi2c_32 (USI13 second HSI2C, 0x10970000), fuel
- * gauge 0x36 and charger 0x69 (Samsung max77865_fuelgauge.c/_charger.c).
- */
-#define S8TS_HSI2C_PA           0x108e0000u
-#define S8BAT_HSI2C_PA          0x10970000u
-#define S8TS_ALIVE_PA           0x164b0000u
-#define S8TS_GPA1_DAT           0x44u
-#define S8TS_ADDR               0x48u
-#define S8BAT_FG                0x36u
-#define S8BAT_CHG               0x69u
-#define S8TS_FINGERS            10
-#define S8_I2C_CLKIN            26000000u
-#define S8_I2C_SCL_HZ           400000u
-
-static vm_offset_t s8ts_i2c, s8ts_alive, s8bat_i2c;
-static int s8ts_sleep;
-static int s8ts_native;         /* sweetfb_native: iOS sees the whole panel */
-static bool s8ts_down[S8TS_FINGERS];
-static uint16_t s8ts_x[S8TS_FINGERS], s8ts_y[S8TS_FINGERS];
-
-/* i2c-exynos5.c: reset, Exynos8895 fast-mode timing, master auto mode. */
-static void
-s8i2c_reset(vm_offset_t bus)
-{
-	a5touch_write(bus, 0x00, a5touch_read(bus, 0x00) | (1u << 31));
-	a5touch_write(bus, 0x00, a5touch_read(bus, 0x00) & ~(1u << 31));
-	unsigned ftl = (a5touch_read(bus, 0x40) >> 16) & 7;
-	unsigned temp = S8_I2C_CLKIN / S8_I2C_SCL_HZ - (ftl + 3) * 2;
-	unsigned div = temp / 512;
-	unsigned cyc = (temp + ((ftl + 3) % (div + 1)) * 2) / (div + 1) - 2;
-	unsigned l = cyc * 64 / 100, h = cyc - l;
-	a5touch_write(bus, 0x60, l << 24 | l << 16 | l << 8);
-	a5touch_write(bus, 0x64, (l / 2) << 24 | l << 8 | h);
-	a5touch_write(bus, 0x68, div << 16 | cyc);
-	a5touch_write(bus, 0x6c, l / 2);
-	a5touch_write(bus, 0x48, a5touch_read(bus, 0x48) & ~(1u << 31));
-	a5touch_write(bus, 0x00, 0x9);
-	a5touch_write(bus, 0x08, 0xf);
-	a5touch_write(bus, 0x40, a5touch_read(bus, 0x40) | (1u << 31));
-}
-
-/* INT_STATUS: bit 7 TRANS_DONE, bits 8-11 abort/no-ack/no-dev/timeout. */
-static bool
-s8i2c_wait_done(vm_offset_t bus)
-{
-	for (unsigned us = 0; us < 20000; us++) {
-		uint32_t s = a5touch_read(bus, 0x24);
-		if (s & 0xf80u) {
-			a5touch_write(bus, 0x24, s);
-			return !(s & 0xf00u);
-		}
-		delay(1);
-	}
-	return false;
-}
-
-/* Write wlen bytes, then read rlen bytes (repeated start); STOP at the end. */
-static bool
-s8i2c_xfer(vm_offset_t bus, unsigned addr, const uint8_t *w, unsigned wlen,
-    uint8_t *r, unsigned rlen)
-{
-	a5touch_write(bus, 0x24, a5touch_read(bus, 0x24));
-	a5touch_write(bus, 0x70, addr << 10);
-	a5touch_write(bus, 0x20, 0xf80u);
-	if (wlen) {
-		a5touch_write(bus, 0x04, 3);
-		a5touch_write(bus, 0x00, 0x9 | 0x80);
-		a5touch_write(bus, 0x44, (rlen ? 0 : (1u << 17)) | wlen | (1u << 31));
-		for (unsigned i = 0; i < wlen; i++) {
-			for (unsigned n = 0; n < 1000 && (a5touch_read(bus, 0x30) & (1u << 7)); n++) {
-				delay(1);
-			}
-			a5touch_write(bus, 0x34, w[i]);
-		}
-		if (!s8i2c_wait_done(bus)) {
-			goto fail;
-		}
-	}
-	if (rlen) {
-		a5touch_write(bus, 0x04, 3);
-		a5touch_write(bus, 0x00, 0x9 | 0x40);
-		a5touch_write(bus, 0x44, (1u << 16) | (1u << 17) | rlen | (1u << 31));
-		for (unsigned i = 0; i < rlen; i++) {
-			unsigned n = 0;
-			while ((a5touch_read(bus, 0x30) & (1u << 24)) && n++ < 20000) {
-				delay(1);
-			}
-			if (a5touch_read(bus, 0x30) & (1u << 24)) {
-				goto fail;
-			}
-			r[i] = (uint8_t)a5touch_read(bus, 0x38);
-		}
-		if (!s8i2c_wait_done(bus)) {
-			goto fail;
-		}
-	}
-	a5touch_write(bus, 0x00, 0x9);
-	return true;
-fail:
-	s8i2c_reset(bus);
-	return false;
-}
-
-static bool
-s8ts_cmd_read(uint8_t cmd, uint8_t *r, unsigned rlen)
-{
-	return s8i2c_xfer(s8ts_i2c, S8TS_ADDR, &cmd, 1, r, rlen);
-}
-
-static void
-s8ts_report(const uint8_t *ev)
-{
-	if ((ev[0] & 3) != 0 || !(ev[0] & 0x3c)) {
-		return;         /* status/info event, or no touch id */
-	}
-	unsigned tid = ((ev[0] & 0x3cu) >> 2) - 1;
-	unsigned state = (ev[0] & 0xc0u) >> 6;
-	if (tid >= S8TS_FINGERS) {
-		return;
-	}
-	unsigned x = ((unsigned)ev[1] << 4) | (ev[3] >> 4);
-	unsigned y = ((unsigned)ev[2] << 4) | (ev[3] & 0xf);
-	if (s8ts_native) {
-		x = x * 1080 / 4096;
-		y = y * 1920 / 4096;
-	} else {
-		/* 1125x2436 is shown centered on the 1440x2960 panel. */
-		int px = (int)(x * 1440 / 4096) - (1440 - 1125) / 2;
-		int py = (int)(y * 2960 / 4096) - (2960 - 2436) / 2;
-		px = px < 0 ? 0 : (px > 1124 ? 1124 : px);
-		py = py < 0 ? 0 : (py > 2435 ? 2435 : py);
-		x = (unsigned)px * 1080 / 1125;
-		y = (unsigned)py * 1920 / 2436;
-	}
-	if (state == 1 || state == 2) {             /* press, move */
-		if (!s8ts_down[tid]) {
-			printf("S8 TOUCH: down id=%u x=%u y=%u\n", tid, x, y);
-		}
-		s8ts_down[tid] = true;
-		s8ts_x[tid] = (uint16_t)x;
-		s8ts_y[tid] = (uint16_t)y;
-		if (tid < 5) {
-			sweet_hid_touch((int)tid, 1, (int)x, (int)y);
-		}
-	} else if (state == 3 && s8ts_down[tid]) { /* release */
-		s8ts_down[tid] = false;
-		if (tid < 5) {
-			sweet_hid_touch((int)tid, 0, s8ts_x[tid], s8ts_y[tid]);
-		}
-	}
-}
-
-static void
-s8ts_wait(unsigned ms)
-{
-	uint64_t deadline;
-	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
-	(void)assert_wait_deadline(&s8ts_sleep, THREAD_UNINT, deadline);
-	thread_block(THREAD_CONTINUE_NULL);
-}
-
-static void
-s8ts_thread(void *arg, wait_result_t result)
-{
-	uint8_t buf[8 * 32];
-	unsigned errors = 0;
-	(void)arg;
-	(void)result;
-	printf("S8 TOUCH: worker started\n");
-	for (;;) {
-		/* INT is level low while events are queued. */
-		if (a5touch_read(s8ts_alive, S8TS_GPA1_DAT) & 1u) {
-			s8ts_wait(8);
-			continue;
-		}
-		if (!s8ts_cmd_read(0x60, buf, 8)) {         /* READ_ONE_EVENT */
-			if (++errors <= 8 || !(errors & 255)) {
-				printf("S8 TOUCH: event read failed (%u)\n", errors);
-			}
-			s8ts_wait(20);
-			continue;
-		}
-		unsigned left = buf[7] & 0x3fu;
-		if (buf[0] && left && left < 32 &&
-		    !s8ts_cmd_read(0x61, buf + 8, left * 8)) {   /* READ_ALL_EVENT */
-			left = 0;
-		}
-		if (!buf[0]) {
-			s8ts_wait(4);       /* INT low with an empty queue */
-			continue;
-		}
-		for (unsigned i = 0; i <= left; i++) {
-			if (buf[i * 8]) {
-				s8ts_report(buf + i * 8);
-			}
-		}
-		errors = 0;
-	}
-}
-
-static bool
-s8bat_read16(unsigned addr, uint8_t reg, uint16_t *value)
-{
-	uint8_t b[2];
-	if (!s8i2c_xfer(s8bat_i2c, addr, &reg, 1, b, 2)) {
-		return false;
-	}
-	*value = (uint16_t)(b[0] | (b[1] << 8));
-	return true;
-}
-
-/*
- * SweetBattery (patch 0124) calls this every 30 s. 0 = valid sample.
- * MAX77865 fuel gauge: SOCREP 0x06 in 1/256 %, VCELL 0x09 in 78.125 uV,
- * CURRENT 0x0a signed 156.25 uA (0.01 ohm sense, positive = charging).
- * Charger: INT_OK 0xb2 bit 6 CHGIN_OK; DETAILS_01 0xb4 [3:0] 0-2 charging,
- * 3-4 done.
- */
-int dreamlte_battery_read(unsigned *percent, unsigned *mv, int *ma,
-    int *external, int *charging, int *full);
-int
-dreamlte_battery_read(unsigned *percent, unsigned *mv, int *ma,
-    int *external, int *charging, int *full)
-{
-	uint16_t soc, vcell, cur;
-	uint8_t reg, ok = 0, dtls = 0;
-	if (!s8bat_i2c) {
-		s8bat_i2c = ml_io_map(S8BAT_HSI2C_PA, 0x1000);
-		if (!s8bat_i2c) {
-			return -1;
-		}
-		s8i2c_reset(s8bat_i2c);
-	}
-	if (!s8bat_read16(S8BAT_FG, 0x06, &soc) || !s8bat_read16(S8BAT_FG, 0x09, &vcell) ||
-	    !s8bat_read16(S8BAT_FG, 0x0a, &cur)) {
-		return -1;
-	}
-	reg = 0xb2;
-	(void)s8i2c_xfer(s8bat_i2c, S8BAT_CHG, &reg, 1, &ok, 1);
-	reg = 0xb4;
-	(void)s8i2c_xfer(s8bat_i2c, S8BAT_CHG, &reg, 1, &dtls, 1);
-	unsigned pct = (unsigned)(soc >> 8) + ((soc & 0xffu) >= 128 ? 1 : 0);
-	*percent = pct > 100 ? 100 : pct;
-	*mv = (unsigned)((uint32_t)vcell * 78125u / 1000000u);
-	*ma = (int)((int16_t)cur) * 15625 / 100000;
-	*external = (ok & 0x40u) != 0;
-	dtls &= 0x0f;
-	*charging = *external && dtls <= 2;
-	*full = *external && (dtls == 3 || dtls == 4);
-	return (*mv >= 2800 && *mv <= 4600) ? 0 : -1;
-}
-
-static void
-dreamlte_touch_start(void)
-{
-	uint8_t b[11] = {0};
-	thread_t thread;
-	int enabled = 1;
-	(void)PE_parse_boot_argn("s8touch", &enabled, sizeof(enabled));
-	(void)PE_parse_boot_argn("sweetfb_native", &s8ts_native, sizeof(s8ts_native));
-	if (!enabled) {
-		printf("S8 TOUCH: disabled\n");
-		return;
-	}
-	s8ts_i2c = ml_io_map(S8TS_HSI2C_PA, 0x1000);
-	s8ts_alive = ml_io_map(S8TS_ALIVE_PA, 0x1000);
-	if (!s8ts_i2c || !s8ts_alive) {
-		printf("S8 TOUCH: MMIO mapping failed\n");
-		return;
-	}
-	s8i2c_reset(s8ts_i2c);
-	if (!s8ts_cmd_read(0x55, b, 1) || b[0] != 0x20) {     /* BOOT_STATUS */
-		printf("S8 TOUCH: no S6SY761 in application mode (status %#x)\n", b[0]);
-		return;
-	}
-	if (s8ts_cmd_read(0x52, b, 3)) {                       /* DEVICE_ID */
-		printf("S8 TOUCH: S6SY761 id %02x%02x%02x\n", b[0], b[1], b[2]);
-	}
-	uint8_t func[3] = {0x30, 0x01, 0x00};                  /* TOUCH_FUNCTION = touch */
-	uint8_t sense = 0x10;                                   /* SENSE_ON */
-	if (!s8i2c_xfer(s8ts_i2c, S8TS_ADDR, func, 3, NULL, 0) ||
-	    !s8i2c_xfer(s8ts_i2c, S8TS_ADDR, &sense, 1, NULL, 0)) {
-		printf("S8 TOUCH: enable sequence failed\n");
-		return;
-	}
-	if (kernel_thread_start(s8ts_thread, NULL, &thread) == KERN_SUCCESS) {
-		thread_deallocate(thread);
-	} else {
-		printf("S8 TOUCH: thread start failed\n");
-	}
-}
-#endif /* DREAMLTE */
-
-void
-a5xelte_touch_probe(void)
-{
-#if defined(DREAMLTE)
-	dreamlte_touch_start();   /* the A5 path below stays off */
-#endif
-	int enabled = A5_TOUCH_DEFAULT; /* A5 touch: off on the S8 */
-	int log_contacts = 0;
-	int bus_trial = 0;
-	vm_offset_t alive;
-	vm_offset_t nfc;
-	vm_offset_t mifpins;
-	vm_offset_t peri;
-	vm_offset_t mif;
-	uint32_t pclk;
-	uint32_t mifclk;
-	(void)PE_parse_boot_argn("a5touchprobe", &enabled, sizeof(enabled));
-	(void)PE_parse_boot_argn("a5touchlog", &log_contacts, sizeof(log_contacts));
-	if (!enabled) {
-		return;
-	}
-	alive = ml_io_map(0x139b0000, 0x1000);
-	nfc = ml_io_map(0x138c0000, 0x1000);
-	mifpins = ml_io_map(0x104e0000, 0x1000);
-	peri = ml_io_map(0x139f0000, 0x1000);
-	mif = ml_io_map(0x10430000, 0x1000);
-	if (!alive || !nfc || !mifpins || !peri || !mif) {
-		printf("A5XELTE TOUCH: probe MMIO mapping failed\n");
-		return;
-	}
-	pclk = a5touch_read(peri, 0x904);
-	mifclk = a5touch_read(mif, 0x900);
-	printf("A5XELTE TOUCH: INT GPA1 con=%#x dat=%#x; GPC3 con=%#x dat=%#x pud=%#x\n",
-	    a5touch_read(alive, 0x20), a5touch_read(alive, 0x24),
-	    a5touch_read(nfc, 0), a5touch_read(nfc, 4), a5touch_read(nfc, 8));
-	printf("A5XELTE TOUCH: I2C2 gate=%d MIF HSI2C3 gate=%d GPM0 con=%#x dat=%#x pud=%#x\n",
-	    !!(pclk & (1u << 9)), !!(mifclk & (1u << 27)),
-	    a5touch_read(mifpins, 0), a5touch_read(mifpins, 4),
-	    a5touch_read(mifpins, 8));
-	if (pclk & (1u << 9)) {
-		vm_offset_t i2c = ml_io_map(0x13850000, 0x1000);
-		if (i2c) {
-			printf("A5XELTE TOUCH: I2C2 con=%#x stat=%#x add=%#x lc=%#x (read only)\n",
-			    a5touch_read(i2c, 0), a5touch_read(i2c, 4),
-			    a5touch_read(i2c, 8), a5touch_read(i2c, 0x10));
-		}
-		(void)PE_parse_boot_argn("a5touchbus", &bus_trial, sizeof(bus_trial));
-		if (log_contacts && (mifclk & (1u << 27))) {
-			if (a5touch_power_on(mifpins)) {
-				a5touch_start_early(nfc, alive);
-			}
-		} else if (bus_trial) {
-			a5touch_chip_code_trial(nfc);
-		}
-	}
-}
-#endif
diff --git a/bsd/dev/samsung_emmc.c b/bsd/dev/samsung_emmc.c
new file mode 100644
index 0000000..b2c71c1
--- /dev/null
+++ b/bsd/dev/samsung_emmc.c
@@ -0,0 +1,745 @@
+/*
+ * Exynos7580 DesignWare eMMC bring-up.
+ *
+ * The Samsung bootloader has already selected the eMMC user area and set up
+ * its clocks and pads. Do not reset that state. Root writes require
+ * emmcroot=USERDATA and emmcwrite=1. An opt-in console log uses only the
+ * first 4 MiB + 512 bytes of the GPT-verified SYSTEM partition.
+ * The host register map and FIFO width rules follow the working downstream
+ * dw_mmc / dw_mmc-exynos driver for the SM-A510F.
+ */
+#if (defined(ARM64_BOARD_CONFIG_A5XELTE) || defined(ARM64_BOARD_CONFIG_EXYNOS990))
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/buf.h>
+#include <sys/conf.h>
+#include <sys/disk.h>
+#include <sys/errno.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+#include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+
+#define SAMSUNG_LOG_SIZE   (4u << 20)
+#define SAMSUNG_LOG_SECTORS (1u + SAMSUNG_LOG_SIZE / 512u)
+
+#define EMMC_CTRL       0x000u
+#define EMMC_PWREN      0x004u
+#define EMMC_CLKENA     0x010u
+#define EMMC_TMOUT      0x014u
+#define EMMC_BLKSIZ     0x01cu
+#define EMMC_BYTCNT     0x020u
+#define EMMC_INTMASK    0x024u
+#define EMMC_CMDARG     0x028u
+#define EMMC_CMD        0x02cu
+#define EMMC_RINTSTS    0x044u
+#define EMMC_STATUS     0x048u
+#define EMMC_TCBCNT     0x05cu
+#define EMMC_TBBCNT     0x060u
+#define EMMC_VERID      0x06cu
+#define EMMC_HCON       0x070u
+#define EMMC_FIFO_DEPTH 64u /* downstream DT fifo-depth = <0x40> */
+#define EMMC_CLKSEL     0x0a8u /* Exynos7580 64-bit IDMAC register map */
+
+#define CTRL_INT_ENABLE (1u << 4)
+#define CTRL_DMA_ENABLE (1u << 5)
+#define CTRL_USE_IDMAC  (1u << 25)
+#define CTRL_FIFO_RESET (1u << 1)
+#define CMD_START       (1u << 31)
+#define CMD_HOLD        (1u << 29)
+#define CMD_WAIT_DATA   (1u << 13)
+#define CMD_DATA        (1u << 9)
+#define CMD_WRITE       (1u << 10)
+#define CMD_RESP_CRC    (1u << 8)
+#define CMD_RESP       (1u << 6)
+#define INT_DATA_OVER   (1u << 3)
+#define INT_CMD_DONE    (1u << 2)
+#define INT_RXDR        (1u << 5)
+#define INT_TXDR        (1u << 4)
+#define INT_ERRORS      ((1u << 12) | (1u << 11) | (1u << 10) | (1u << 9) | \
+                         (1u << 8) | (1u << 7) | (1u << 6) | (1u << 1))
+
+static vm_offset_t emmc_regs;
+static uint64_t emmc_first_lba, emmc_nsectors;
+static char emmc_partition_name[16] = "SYSTEM";
+static dev_t emmc_bdev;
+static bool emmc_ready;
+static bool emmc_writable;
+static uint64_t emmc_log_first_lba, emmc_log_nsectors;
+static bool emmc_log_enabled;
+static char emmc_log_ring[SAMSUNG_LOG_SIZE];
+static uint64_t _Atomic emmc_log_total;
+static int emmc_log_chan;
+static LCK_GRP_DECLARE(samsung_emmc_grp, "samsung_emmc");
+static LCK_MTX_DECLARE(samsung_emmc_lock, &samsung_emmc_grp);
+
+static inline uint32_t
+emmc_rd(uint32_t off)
+{
+	return *(volatile uint32_t *)(emmc_regs + off);
+}
+
+static inline void
+emmc_wr(uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(emmc_regs + off) = value;
+}
+
+static int
+emmc_read_sector(uint32_t lba, uint8_t *sector)
+{
+	uint64_t data[64] = { 0 };
+	uint32_t hcon = emmc_rd(EMMC_HCON);
+	uint32_t width = (hcon >> 7) & 7u;
+	uint32_t ver = emmc_rd(EMMC_VERID) & 0xffffu;
+	uint32_t data_off = ver < 0x240au ? 0x100u : 0x200u;
+	uint32_t unit, words, read_words = 0;
+	uint32_t ctrl = emmc_rd(EMMC_CTRL);
+	uint32_t ints = emmc_rd(EMMC_INTMASK);
+	int error = 0;
+
+	if (width > 2 || ver == 0 || ver == 0xffff ||
+	    !(emmc_rd(EMMC_PWREN) & 1u) || !(emmc_rd(EMMC_CLKENA) & 1u)) {
+		printf("A5XELTE eMMC: host unavailable (ver=%x hcon=%x clk=%x)\n",
+		    ver, hcon, emmc_rd(EMMC_CLKENA));
+		return ENXIO;
+	}
+	unit = 2u << width;
+	words = 512u / unit;
+	if (emmc_rd(EMMC_STATUS) & (1u << 9)) {
+		printf("A5XELTE eMMC: data path busy; skipping probe\n");
+		return EBUSY;
+	}
+
+	/* Polled PIO, preserving the bootloader's clock, pads and bus timing. */
+	emmc_wr(EMMC_INTMASK, 0);
+	emmc_wr(EMMC_CTRL, (ctrl & ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE |
+	    CTRL_USE_IDMAC)) | CTRL_FIFO_RESET);
+	for (unsigned i = 0; i < 1000000; i++) {
+		if (!(emmc_rd(EMMC_CTRL) & CTRL_FIFO_RESET)) {
+			break;
+		}
+		if (i == 999999) {
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	/* Known-good Linux attempt23 encoding: counter [31:11], extension [10:8]. */
+	emmc_wr(EMMC_TMOUT, 0x573177ffu);
+	emmc_wr(EMMC_BLKSIZ, 512);
+	emmc_wr(EMMC_BYTCNT, 512);
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, lba); /* high-capacity eMMC sector address */
+	uint32_t command = CMD_START | CMD_WAIT_DATA | CMD_DATA |
+	    CMD_RESP_CRC | CMD_RESP | 17u;
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) {
+		command |= CMD_HOLD;
+	}
+	emmc_wr(EMMC_CMD, command);
+	for (unsigned i = 0; i < 4000000; i++) {
+		uint32_t pending = emmc_rd(EMMC_RINTSTS);
+		if (pending & INT_ERRORS) {
+			printf("A5XELTE eMMC: CMD17 error rint=%x status=%x words=%u/%u first=%llx tcbc=%u tbbc=%u\n",
+			    pending, emmc_rd(EMMC_STATUS), read_words, words, data[0],
+			    emmc_rd(EMMC_TCBCNT), emmc_rd(EMMC_TBBCNT));
+			error = EIO;
+			goto out;
+		}
+		uint32_t fifo = (emmc_rd(EMMC_STATUS) >> 17) & 0x1fffu;
+		while (fifo && read_words < words) {
+			if (unit == 8) {
+				/* Exynos7580 requires paired 32-bit SFR accesses for a 64-bit FIFO unit. */
+				uint32_t lo = emmc_rd(data_off);
+				uint32_t hi = emmc_rd(data_off + 4);
+				data[read_words] = (uint64_t)lo | ((uint64_t)hi << 32);
+			} else if (unit == 4) {
+				((uint32_t *)data)[read_words] = emmc_rd(data_off);
+			} else {
+				((uint16_t *)data)[read_words] =
+				    *(volatile uint16_t *)(emmc_regs + data_off);
+			}
+			read_words++;
+			fifo--;
+		}
+		/* The downstream PIO handler acknowledges RXDR after each FIFO drain. */
+		if (pending & INT_RXDR) {
+			emmc_wr(EMMC_RINTSTS, INT_RXDR);
+		}
+		if (read_words == words &&
+		    (pending & INT_DATA_OVER) && (pending & INT_CMD_DONE)) {
+			break;
+		}
+		if (i == 3999999) {
+			printf("A5XELTE eMMC: CMD17 timeout rint=%x words=%u/%u first=%llx tcbc=%u tbbc=%u\n",
+			    pending, read_words, words, data[0],
+			    emmc_rd(EMMC_TCBCNT), emmc_rd(EMMC_TBBCNT));
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	memcpy(sector, data, 512);
+out:
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_INTMASK, ints);
+	/* Keep DMA disabled: this probe does not own the bootloader's descriptors. */
+	return error;
+}
+
+static int
+emmc_write_sector(uint32_t lba, const uint8_t *sector)
+{
+	uint64_t data[64];
+	uint32_t hcon = emmc_rd(EMMC_HCON);
+	uint32_t width = (hcon >> 7) & 7u;
+	uint32_t ver = emmc_rd(EMMC_VERID) & 0xffffu;
+	uint32_t data_off = ver < 0x240au ? 0x100u : 0x200u;
+	uint32_t unit, words, written = 0;
+	uint32_t ctrl = emmc_rd(EMMC_CTRL);
+	uint32_t ints = emmc_rd(EMMC_INTMASK);
+	int error = 0;
+
+	uint64_t address = lba;
+	bool root_write = emmc_writable && address >= emmc_first_lba &&
+	    address - emmc_first_lba < emmc_nsectors;
+	bool log_write = emmc_log_enabled && address >= emmc_log_first_lba &&
+	    address - emmc_log_first_lba < SAMSUNG_LOG_SECTORS;
+	if (!root_write && !log_write) {
+		return EROFS;
+	}
+	if (width > 2 || ver == 0 || ver == 0xffff ||
+	    !(emmc_rd(EMMC_PWREN) & 1u) || !(emmc_rd(EMMC_CLKENA) & 1u)) {
+		return ENXIO;
+	}
+	unit = 2u << width;
+	words = 512u / unit;
+	if (emmc_rd(EMMC_STATUS) & (1u << 9)) {
+		return EBUSY;
+	}
+	memcpy(data, sector, 512);
+	emmc_wr(EMMC_INTMASK, 0);
+	emmc_wr(EMMC_CTRL, (ctrl & ~(CTRL_INT_ENABLE | CTRL_DMA_ENABLE |
+	    CTRL_USE_IDMAC)) | CTRL_FIFO_RESET);
+	for (unsigned i = 0; i < 1000000; i++) {
+		if (!(emmc_rd(EMMC_CTRL) & CTRL_FIFO_RESET)) {
+			break;
+		}
+		if (i == 999999) {
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	emmc_wr(EMMC_TMOUT, 0x573177ffu);
+	emmc_wr(EMMC_BLKSIZ, 512);
+	emmc_wr(EMMC_BYTCNT, 512);
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_CMDARG, lba);
+	uint32_t command = CMD_START | CMD_WAIT_DATA | CMD_DATA | CMD_WRITE |
+	    CMD_RESP_CRC | CMD_RESP | 24u;
+	if ((emmc_rd(EMMC_CLKSEL) >> 16) & 7u) {
+		command |= CMD_HOLD;
+	}
+	emmc_wr(EMMC_CMD, command);
+	for (unsigned i = 0; i < 4000000; i++) {
+		uint32_t pending = emmc_rd(EMMC_RINTSTS);
+		if (pending & INT_ERRORS) {
+			printf("A5XELTE eMMC: CMD24 error lba=%u rint=%x status=%x words=%u/%u\n",
+			    lba, pending, emmc_rd(EMMC_STATUS), written, words);
+			error = EIO;
+			goto out;
+		}
+		uint32_t fifo = (emmc_rd(EMMC_STATUS) >> 17) & 0x1fffu;
+		while (fifo < EMMC_FIFO_DEPTH && written < words) {
+			if (unit == 8) {
+				/* Downstream CONFIG_MMC_DW_FORCE_32BIT_SFR_RW. */
+				emmc_wr(data_off, (uint32_t)data[written]);
+				emmc_wr(data_off + 4, (uint32_t)(data[written] >> 32));
+			} else if (unit == 4) {
+				emmc_wr(data_off, ((uint32_t *)data)[written]);
+			} else {
+				*(volatile uint16_t *)(emmc_regs + data_off) =
+				    ((uint16_t *)data)[written];
+			}
+			written++;
+			fifo++;
+		}
+		if (pending & INT_TXDR) {
+			emmc_wr(EMMC_RINTSTS, INT_TXDR);
+		}
+		if (written == words && (pending & INT_DATA_OVER) &&
+		    (pending & INT_CMD_DONE)) {
+			break;
+		}
+		if (i == 3999999) {
+			printf("A5XELTE eMMC: CMD24 timeout lba=%u rint=%x words=%u/%u tcbc=%u\n",
+			    lba, pending, written, words, emmc_rd(EMMC_TCBCNT));
+			error = ETIMEDOUT;
+			goto out;
+		}
+	}
+	for (unsigned i = 0; i < 4000000; i++) {
+		if (!(emmc_rd(EMMC_STATUS) & (1u << 9))) {
+			break;
+		}
+		if (i == 3999999) {
+			error = ETIMEDOUT;
+			printf("A5XELTE eMMC: CMD24 card busy after data lba=%u\n", lba);
+		}
+	}
+out:
+	emmc_wr(EMMC_RINTSTS, 0xffffffffu);
+	emmc_wr(EMMC_INTMASK, ints);
+	return error;
+}
+
+static uint32_t
+emmc_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	    (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static uint64_t
+emmc_le64(const uint8_t *p)
+{
+	return emmc_le32(p) | (uint64_t)emmc_le32(p + 4) << 32;
+}
+
+static uint32_t
+emmc_crc32(uint32_t crc, const uint8_t *data, size_t len)
+{
+	for (size_t i = 0; i < len; i++) {
+		crc ^= data[i];
+		for (unsigned bit = 0; bit < 8; bit++) {
+			crc = (crc >> 1) ^ (0xedb88320u & -(crc & 1u));
+		}
+	}
+	return crc;
+}
+
+static int
+emmc_find_root_partition(void)
+{
+	uint8_t hdr[512], entry[512];
+	(void)PE_parse_boot_argn("emmcroot", emmc_partition_name,
+	    sizeof(emmc_partition_name));
+	emmc_partition_name[sizeof(emmc_partition_name) - 1] = '\0';
+	if (strcmp(emmc_partition_name, "SYSTEM") &&
+	    strcmp(emmc_partition_name, "USERDATA")) {
+		printf("A5XELTE eMMC: emmcroot must be SYSTEM or USERDATA\n");
+		return EINVAL;
+	}
+	emmc_first_lba = 0;
+	emmc_nsectors = 0;
+	emmc_log_first_lba = 0;
+	emmc_log_nsectors = 0;
+	int error = emmc_read_sector(1, hdr);
+	if (error) {
+		return error;
+	}
+	uint32_t header_size = emmc_le32(hdr + 12);
+	if (memcmp(hdr, "EFI PART", 8) ||
+	    (header_size != 92 && header_size != 512) ||
+	    emmc_le64(hdr + 24) != 1) {
+		printf("A5XELTE eMMC: invalid GPT header\n");
+		return ENXIO;
+	}
+	uint32_t expected_header_crc = emmc_le32(hdr + 16);
+	memset(hdr + 16, 0, 4);
+	if ((emmc_crc32(~0u, hdr, header_size) ^ ~0u) != expected_header_crc) {
+		printf("A5XELTE eMMC: GPT header CRC mismatch\n");
+		return EIO;
+	}
+	uint64_t first_usable = emmc_le64(hdr + 40);
+	uint64_t last_usable = emmc_le64(hdr + 48);
+	uint64_t entry_lba = emmc_le64(hdr + 72);
+	uint32_t nentries = emmc_le32(hdr + 80);
+	uint32_t entry_size = emmc_le32(hdr + 84);
+	if (entry_lba < 2 || entry_lba > 1024 || nentries == 0 ||
+	    nentries > 128 || (nentries & 3u) || entry_size != 128 ||
+	    first_usable > last_usable || last_usable > UINT32_MAX) {
+		printf("A5XELTE eMMC: unsupported GPT layout\n");
+		return ENXIO;
+	}
+	uint32_t crc = ~0u;
+	for (uint32_t s = 0; s < nentries / 4; s++) {
+		error = emmc_read_sector((uint32_t)entry_lba + s, entry);
+		if (error) {
+			return error;
+		}
+		crc = emmc_crc32(crc, entry, 512);
+		for (uint32_t j = 0; j < 4; j++) {
+			const uint8_t *p = entry + j * 128;
+			bool match = true;
+			bool system_match = true;
+			static const char system_name[] = "SYSTEM";
+			for (unsigned k = 0; k <= strlen(emmc_partition_name); k++) {
+				if (p[56 + k * 2] != (uint8_t)emmc_partition_name[k] ||
+				    p[57 + k * 2] != 0) {
+					match = false;
+					break;
+				}
+			}
+			for (unsigned k = 0; k < sizeof(system_name); k++) {
+				if (p[56 + k * 2] != (uint8_t)system_name[k] ||
+				    p[57 + k * 2] != 0) {
+					system_match = false;
+					break;
+				}
+			}
+			if (match || system_match) {
+				uint64_t first = emmc_le64(p + 32);
+				uint64_t last = emmc_le64(p + 40);
+				if (first < first_usable || last > last_usable || first > last) {
+					return EINVAL;
+				}
+				if (match) {
+					emmc_first_lba = first;
+					emmc_nsectors = last - first + 1;
+				}
+				if (system_match) {
+					emmc_log_first_lba = first;
+					emmc_log_nsectors = last - first + 1;
+				}
+			}
+		}
+	}
+	if ((crc ^ ~0u) != emmc_le32(hdr + 88)) {
+		printf("A5XELTE eMMC: GPT entries CRC mismatch\n");
+		return EIO;
+	}
+	if (emmc_log_first_lba == emmc_first_lba && emmc_log_nsectors &&
+	    strcmp(emmc_partition_name, "SYSTEM") == 0) {
+		/* A log writer must never overlap the selected root. */
+		emmc_log_nsectors = 0;
+	}
+	if (!emmc_nsectors) {
+		printf("A5XELTE eMMC: %s partition not found\n", emmc_partition_name);
+		return ENXIO;
+	}
+	int enable_write = 0;
+	(void)PE_parse_boot_argn("emmcwrite", &enable_write, sizeof(enable_write));
+	emmc_writable = !strcmp(emmc_partition_name, "USERDATA") && enable_write == 1;
+	printf("A5XELTE eMMC: GPT %s first=%llu sectors=%llu %s\n",
+	    emmc_partition_name, emmc_first_lba, emmc_nsectors,
+	    emmc_writable ? "writable" : "read-only");
+	return 0;
+}
+
+static int
+emmc_map_host(void)
+{
+	DTEntry node;
+	uintptr_t const *reg = NULL;
+	unsigned int size = 0;
+	if (emmc_regs) {
+		return 0;
+	}
+	if (SecureDTLookupEntry(NULL, "/samsung-emmc", &node) != kSuccess ||
+	    SecureDTGetProperty(node, "reg", (void const **)&reg, &size) != kSuccess ||
+	    size < 2 * sizeof(uintptr_t) || reg[0] != 0x13540000u || reg[1] < 0x2000u) {
+		printf("A5XELTE eMMC: missing or unexpected ADT register window\n");
+		return ENXIO;
+	}
+	emmc_regs = ml_io_map(reg[0], reg[1]);
+	if (!emmc_regs) {
+		printf("A5XELTE eMMC: MMIO map failed\n");
+		return ENOMEM;
+	}
+	printf("A5XELTE eMMC: host ctrl=%x status=%x clk=%x hcon=%x\n",
+	    emmc_rd(EMMC_CTRL), emmc_rd(EMMC_STATUS),
+	    emmc_rd(EMMC_CLKENA), emmc_rd(EMMC_HCON));
+	return 0;
+}
+
+void
+samsung_emmc_probe(void)
+{
+	if (!emmc_map_host()) {
+		(void)emmc_find_root_partition();
+	}
+}
+
+static int
+emmc_open(__unused dev_t dev, int flags, __unused int devtype, __unused struct proc *p)
+{
+	return !emmc_ready ? ENXIO : ((flags & FWRITE) && !emmc_writable ? EROFS : 0);
+}
+
+static int
+emmc_close(__unused dev_t dev, __unused int flags, __unused int devtype, __unused struct proc *p)
+{
+	return 0;
+}
+
+static uint32_t emmc_secsize = 512;
+static uint8_t emmc_bounce[512];
+
+static void
+emmc_strategy(buf_t bp)
+{
+	int error = 0;
+	caddr_t vaddr = NULL;
+	uint32_t count = buf_count(bp);
+	uint64_t bytes = emmc_nsectors * 512u;
+	uint64_t off = 0;
+	buf_setresid(bp, count);
+	if (!emmc_ready) {
+		error = ENXIO;
+	} else if (!(buf_flags(bp) & B_READ) && !emmc_writable) {
+		error = EROFS;
+	} else if (buf_blkno(bp) < 0) {
+		error = EINVAL;
+	} else {
+		off = (uint64_t)buf_blkno(bp) * emmc_secsize;
+		if (off > bytes || count > bytes - off) {
+			error = EINVAL;
+		}
+	}
+	if (error || count == 0) {
+		goto done;
+	}
+	if (buf_map(bp, &vaddr)) {
+		error = EIO;
+		goto done;
+	}
+	lck_mtx_lock(&samsung_emmc_lock);
+	for (uint32_t n = 0; n < count;) {
+		uint64_t pos = off + n;
+		uint32_t skip = pos & 511u;
+		uint32_t take = MIN(count - n, 512u - skip);
+		uint32_t lba = (uint32_t)(emmc_first_lba + pos / 512u);
+		if (buf_flags(bp) & B_READ) {
+			error = emmc_read_sector(lba, emmc_bounce);
+			if (!error) {
+				memcpy(vaddr + n, emmc_bounce + skip, take);
+			}
+		} else {
+			if (skip || take != 512u) {
+				error = emmc_read_sector(lba, emmc_bounce);
+			}
+			if (!error) {
+				memcpy(emmc_bounce + skip, vaddr + n, take);
+				error = emmc_write_sector(lba, emmc_bounce);
+			}
+		}
+		if (error) {
+			break;
+		}
+		n += take;
+		buf_setresid(bp, count - n);
+	}
+	lck_mtx_unlock(&samsung_emmc_lock);
+	buf_unmap(bp);
+done:
+	if (error) {
+		buf_seterror(bp, error);
+	}
+	buf_biodone(bp);
+}
+
+static int
+emmc_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
+    __unused struct proc *p)
+{
+	switch (cmd) {
+	case DKIOCGETBLOCKSIZE:
+		*(uint32_t *)data = emmc_secsize;
+		return 0;
+	case DKIOCSETBLOCKSIZE: {
+		uint32_t requested = *(uint32_t *)data;
+		if (requested < 512 || requested > 4096 || (requested & (requested - 1))) {
+			return EINVAL;
+		}
+		emmc_secsize = requested;
+		return 0;
+	}
+	case DKIOCGETPHYSICALBLOCKSIZE:
+		*(uint32_t *)data = 512;
+		return 0;
+	case DKIOCGETBLOCKCOUNT:
+		*(uint64_t *)data = emmc_nsectors * 512u / emmc_secsize;
+		return 0;
+	case DKIOCISWRITABLE:
+		*(uint32_t *)data = emmc_writable ? 1 : 0;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTREAD:
+		*(uint64_t *)data = 1;
+		return 0;
+	case DKIOCGETMAXBLOCKCOUNTWRITE:
+		*(uint64_t *)data = emmc_writable ? 1 : 0;
+		return 0;
+	case DKIOCGETMAXSEGMENTCOUNTREAD:
+	case DKIOCGETMAXSEGMENTCOUNTWRITE:
+		*(uint64_t *)data = 1;
+		return 0;
+	case DKIOCSYNCHRONIZE:
+	case DKIOCSYNCHRONIZECACHE:
+		return 0;
+	default:
+		return ENOTTY;
+	}
+}
+
+static int
+emmc_psize(__unused dev_t dev)
+{
+	return emmc_ready ? (int)MIN(emmc_nsectors * 512u / emmc_secsize, INT_MAX) : -1;
+}
+
+static int
+emmc_read(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return physio(emmc_strategy, NULL, dev, B_READ, minphys, uio, (int)emmc_secsize);
+}
+
+static int
+emmc_write(dev_t dev, struct uio *uio, __unused int ioflag)
+{
+	return emmc_writable ? physio(emmc_strategy, NULL, dev, B_WRITE,
+	    minphys, uio, (int)emmc_secsize) : EROFS;
+}
+
+static const struct bdevsw emmc_bdevsw = {
+	.d_open = emmc_open, .d_close = emmc_close, .d_strategy = emmc_strategy,
+	.d_ioctl = emmc_ioctl, .d_dump = eno_dump, .d_psize = emmc_psize,
+	.d_type = D_DISK,
+};
+
+static const struct cdevsw emmc_cdevsw = {
+	.d_open = emmc_open, .d_close = emmc_close, .d_read = emmc_read,
+	.d_write = emmc_write, .d_ioctl = emmc_ioctl, .d_stop = eno_stop,
+	.d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_reserved_1 = eno_getc,
+	.d_reserved_2 = eno_putc, .d_type = D_DISK,
+};
+
+/* _cnputs may execute in any context. Keep this path free of locks and I/O. */
+void samsung_log_append(const char *c, int size);
+void
+samsung_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&emmc_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		emmc_log_ring[(at + (uint64_t)i) % SAMSUNG_LOG_SIZE] = c[i];
+	}
+}
+
+struct samsung_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+emmc_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t flushed = 0, seq = 0;
+	uint8_t sector[512];
+	for (;;) {
+		(void)tsleep(&emmc_log_chan, PZERO, "a5log", hz * 10);
+		uint64_t total = os_atomic_load(&emmc_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= SAMSUNG_LOG_SIZE ? total - SAMSUNG_LOG_SIZE : flushed;
+		int error = 0;
+		lck_mtx_lock(&samsung_emmc_lock);
+		while (pos < total && !error) {
+			uint32_t block = (uint32_t)((pos % SAMSUNG_LOG_SIZE) / 512u);
+			uint64_t lba = emmc_log_first_lba + 1u + block;
+			if (lba >= emmc_log_first_lba + SAMSUNG_LOG_SECTORS || lba > UINT32_MAX) {
+				error = EINVAL;
+				break;
+			}
+			memcpy(sector, emmc_log_ring + (size_t)block * 512u, 512u);
+			error = emmc_write_sector((uint32_t)lba, sector);
+			pos += 512u - (pos & 511u);
+		}
+		if (!error) {
+			struct samsung_log_header h = {
+				.magic = { 'A', '5', 'X', 'L', 'O', 'G', '1', '\0' },
+				.version = 1, .size = SAMSUNG_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			memset(sector, 0, sizeof(sector));
+			memcpy(sector, &h, sizeof(h));
+			error = emmc_write_sector((uint32_t)emmc_log_first_lba, sector);
+		}
+		lck_mtx_unlock(&samsung_emmc_lock);
+		if (error) {
+			printf("A5XELTE LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+emmc_log_start(void)
+{
+	int enabled = 0;
+	thread_t thread;
+	(void)PE_parse_boot_argn("a5log", &enabled, sizeof(enabled));
+	if (enabled != 1 || !emmc_ready || !emmc_writable ||
+	    strcmp(emmc_partition_name, "USERDATA") ||
+	    emmc_log_nsectors < SAMSUNG_LOG_SECTORS ||
+	    emmc_log_first_lba == 0 ||
+	    (emmc_log_first_lba < emmc_first_lba + emmc_nsectors &&
+	    emmc_first_lba < emmc_log_first_lba + SAMSUNG_LOG_SECTORS) ||
+	    emmc_log_first_lba + SAMSUNG_LOG_SECTORS - 1 > UINT32_MAX) {
+		return;
+	}
+	emmc_log_enabled = true;
+	printf("A5XELTE LOG: SYSTEM GPT first=%llu, %u sectors reserved\n",
+	    emmc_log_first_lba, SAMSUNG_LOG_SECTORS);
+	if (kernel_thread_start(emmc_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		emmc_log_enabled = false;
+	}
+}
+
+int
+samsung_emmc_rootdev(dev_t *dev)
+{
+	if (!emmc_ready) {
+		int error = emmc_map_host();
+		if (error) {
+			return error;
+		}
+		error = emmc_find_root_partition();
+		if (error) {
+			return error;
+		}
+		int bmajor = bdevsw_add(-1, &emmc_bdevsw);
+		if (bmajor < 0) {
+			return ENXIO;
+		}
+		int cmajor = cdevsw_add_with_bdev(-1, &emmc_cdevsw, bmajor);
+		if (cmajor < 0) {
+			return ENXIO;
+		}
+		emmc_bdev = makedev(bmajor, 0);
+		devfs_make_node(emmc_bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "emmcroot0");
+		devfs_make_node(makedev(cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "remmcroot0");
+		emmc_ready = true;
+		printf("A5XELTE eMMC: /dev/emmcroot0 ready, GPT %s %s\n",
+		    emmc_partition_name, emmc_writable ? "writable" : "read-only");
+		emmc_log_start();
+	}
+	*dev = emmc_bdev;
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_A5XELTE */
diff --git a/bsd/dev/samsung_keys.c b/bsd/dev/samsung_keys.c
new file mode 100644
index 0000000..2e37206
--- /dev/null
+++ b/bsd/dev/samsung_keys.c
@@ -0,0 +1,130 @@
+/*
+ * Exynos7580 ALIVE GPIO keys for the SM-A510F.
+ *
+ * The working Linux device tree locates Power/Volume Up/Volume Down/Home at
+ * GPA2 pins 7/0/1/5, all active low.  Poll only GPA2DAT; boot firmware owns
+ * the pin mux and pull-ups.  No ALIVE or interrupt-controller writes occur.
+ */
+#if (defined(ARM64_BOARD_CONFIG_A5XELTE) || defined(ARM64_BOARD_CONFIG_EXYNOS990))
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+
+/* SWEET_ALIVE_BASE (pinctrl ALIVE base) comes from the board header:
+ * 0x139b0000 on the Exynos 7580, 0x164b0000 on the Exynos 8895,
+ * 0x15850000 on the Exynos 990. */
+#define GPA2_CON 0x40u
+#define GPA2_DAT 0x44u
+#define GPA2_PUD 0x48u
+
+static vm_offset_t samsung_alive;
+static int samsung_keys_sleep;
+static bool samsung_keys_started;
+
+static uint32_t
+samsung_keys_read(uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(samsung_alive + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+#if defined(DREAMLTE)
+/*
+ * Galaxy S8 (mainline exynos8895-dreamlte.dts gpio-keys, all active low):
+ * Power GPA2-4, Volume Up GPA0-3, Volume Down GPA0-4, Bixby GPA0-6 (used
+ * as Home). Bank offsets per mainline pinctrl-exynos-arm64.c
+ * (exynos8895_pin_banks0): GPA0 0x020, GPA2 0x060; DAT at +4. Boot 22/23
+ * read 0x044 (GPA1 DAT) and saw nothing. Sample = GPA0 | GPA2 << 8.
+ */
+typedef uint16_t keys_t;
+#define KEYS_SAMPLE() ((keys_t)((samsung_keys_read(0x24) & 0xff) | (samsung_keys_read(0x64) & 0xff) << 8))
+#define KEYS_PINS { 12, 3, 4, 6 }
+#else
+typedef uint8_t keys_t;
+#define KEYS_SAMPLE() ((keys_t)samsung_keys_read(GPA2_DAT))
+#define KEYS_PINS { 7, 0, 1, 5 }
+#endif
+
+static void
+samsung_keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(10, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&samsung_keys_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+samsung_keys_thread(void *arg, wait_result_t result)
+{
+	static const uint8_t pins[4] = KEYS_PINS;
+	keys_t stable = KEYS_SAMPLE();
+	keys_t previous = stable;
+	unsigned repeated = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		keys_t sample = KEYS_SAMPLE();
+		if (sample == previous) {
+			if (repeated < 2) {
+				repeated++;
+			}
+		} else {
+			previous = sample;
+			repeated = 0;
+		}
+		if (repeated == 2 && stable != sample) {
+			for (unsigned key = 0; key < 4; key++) {
+				keys_t bit = (keys_t)(1u << pins[key]);
+				if ((stable ^ sample) & bit) {
+					int down = !(sample & bit);
+					printf("A5XELTE KEYS: key=%u down=%d gpio=%#x\n",
+					    key, down, sample);
+					sweet_hid_key((int)key, down);
+				}
+			}
+			stable = sample;
+		}
+		samsung_keys_wait();
+	}
+}
+
+void
+samsung_keys_init(void)
+{
+	thread_t thread;
+	int enabled = SWEET_KEYS_DEFAULT;
+	if (samsung_keys_started) {
+		return;
+	}
+	samsung_keys_started = true;
+	(void)PE_parse_boot_argn("a5keys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("A5XELTE KEYS: disabled\n");
+		return;
+	}
+	samsung_alive = ml_io_map(SWEET_ALIVE_BASE, 0x1000);
+	if (!samsung_alive) {
+		printf("A5XELTE KEYS: ALIVE mapping failed\n");
+		return;
+	}
+	printf("A5XELTE KEYS: GPA2 con=%#x dat=%#x pud=%#x (read only)\n",
+	    samsung_keys_read(GPA2_CON), samsung_keys_read(GPA2_DAT),
+	    samsung_keys_read(GPA2_PUD));
+	kern_return_t kr = kernel_thread_start(samsung_keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A5XELTE KEYS: thread start failed %d\n", kr);
+	}
+}
+#endif
diff --git a/bsd/dev/samsung_touch.c b/bsd/dev/samsung_touch.c
new file mode 100644
index 0000000..c6b2d97
--- /dev/null
+++ b/bsd/dev/samsung_touch.c
@@ -0,0 +1,979 @@
+/*
+ * Early Exynos7580 ZT7538 bring-up probe.  The working native Linux
+ * port uses I2C2 at 0x13850000, GPC3-0/1, GPA1-1 and S2MPU03 LDO33.
+ * Opt-in touch logging enables only the proven S2MPU03 LDO33 supply and
+ * observes ZT7538 contacts before userland. It never programs touch NVM.
+ */
+#if (defined(ARM64_BOARD_CONFIG_A5XELTE) || defined(ARM64_BOARD_CONFIG_EXYNOS990))
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/arm64/board_config.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void thread_terminate_self(void);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void samsung_touch_probe(void);
+static bool a5touch_controller_init(void);
+static bool a5touch_report_packet(const uint8_t packet[34], unsigned *lines);
+static void a5touch_release_contacts(void);
+
+static vm_offset_t samsung_touch_bus;
+static vm_offset_t samsung_touch_alive;
+static vm_offset_t samsung_touch_hsi;
+static int samsung_touch_sleep;
+static bool samsung_touch_active[5];
+static uint16_t samsung_touch_x[5], samsung_touch_y[5];
+
+static uint16_t
+a5touch_le16(const uint8_t *bytes)
+{
+	return (uint16_t)((unsigned)bytes[0] | ((unsigned)bytes[1] << 8));
+}
+
+static uint32_t
+a5touch_read(vm_offset_t base, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(base + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+a5touch_write(vm_offset_t base, uint32_t offset, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + offset) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* Exynos7580 MIF HSI2C3 AUTO mode, matching Linux's 400 kHz timing. */
+static void
+a5pmic_bus_init(vm_offset_t hsi)
+{
+	a5touch_write(hsi, 0x00, 0x80000009u);
+	a5touch_write(hsi, 0x00, 0x00000009u);
+	a5touch_write(hsi, 0x48, 0); /* Linux disables the hardware timeout. */
+	a5touch_write(hsi, 0x60, 0x78787800u);
+	a5touch_write(hsi, 0x64, 0x3c007878u);
+	a5touch_write(hsi, 0x68, 0x000000f0u);
+	a5touch_write(hsi, 0x6c, 0x3cu);
+	a5touch_write(hsi, 0x08, 0xfu);
+	a5touch_write(hsi, 0x40, 0x80000000u);
+	a5touch_write(hsi, 0x20, 0); /* Poll without an unregistered XNU IRQ. */
+}
+
+static bool
+a5pmic_message(vm_offset_t hsi, bool receive, uint8_t *bytes,
+    unsigned count, bool stop)
+{
+	uint32_t ctl;
+	uint32_t cfg;
+	uint32_t last_irq = 0;
+	bool transfer_done = false;
+	unsigned done = 0;
+	if (!count || count > 4) {
+		return false;
+	}
+	/* Exynos7580 is EXYNOS7: TRANS_STATUS[3:0] is an FSM state,
+	 * not the Exynos5 completion/error bitmap. Linux uses INT_STATUS. */
+	a5touch_write(hsi, 0x24, a5touch_read(hsi, 0x24));
+	a5touch_write(hsi, 0x04, 3u | (count << (receive ? 4 : 16)));
+	ctl = 9u | (receive ? 0x40u : 0x80u);
+	a5touch_write(hsi, 0x70, 0x66u << 10);
+	a5touch_write(hsi, 0x00, ctl);
+	cfg = count | (receive ? 0x10000u : 0) | (stop ? 0x20000u : 0);
+	/* GIC SPI for this controller is masked in the A5XELTE platform;
+	 * enable the controller's status bits and service them by polling. */
+	a5touch_write(hsi, 0x20, 0xf80u | (receive ? 0x42u : 1u));
+	a5touch_write(hsi, 0x44, cfg | 0x80000000u);
+	for (unsigned us = 0; us < 100000; us++) {
+		uint32_t fifo = a5touch_read(hsi, 0x30);
+		uint32_t irq = a5touch_read(hsi, 0x24);
+		if (irq) {
+			last_irq |= irq;
+			a5touch_write(hsi, 0x24, irq);
+		}
+		if (irq & 0xf00u) {
+			printf("A5XELTE TOUCH: PMIC HSI2C error rx=%d done=%u/%u irq=%#x state=%#x fifo=%#x\n",
+			    receive, done, count, last_irq, a5touch_read(hsi, 0x50), fifo);
+			goto fail;
+		}
+		if (irq & 0x80u) {
+			transfer_done = true;
+		}
+		if (receive) {
+			while (done < count && ((a5touch_read(hsi, 0x30) >> 16) & 0x7fu)) {
+				bytes[done++] = (uint8_t)a5touch_read(hsi, 0x38);
+			}
+		} else {
+			while (done < count && !(a5touch_read(hsi, 0x30) & (1u << 7))) {
+				a5touch_write(hsi, 0x34, bytes[done++]);
+			}
+			if (done == count) {
+				a5touch_write(hsi, 0x20, 0xf80u);
+			}
+		}
+		if (done == count && transfer_done) {
+			a5touch_write(hsi, 0x20, 0);
+			if (stop) {
+				for (unsigned n = 0; n < 100000; n++) {
+					if (!(a5touch_read(hsi, 0x50) & (1u << 17))) {
+						return true;
+					}
+					delay(1);
+				}
+				printf("A5XELTE TOUCH: PMIC STOP busy irq=%#x state=%#x\n",
+				    last_irq, a5touch_read(hsi, 0x50));
+				goto fail;
+			}
+			return true;
+		}
+		delay(1);
+	}
+	printf("A5XELTE TOUCH: PMIC HSI2C timeout rx=%d done=%u/%u irq=%#x state=%#x fifo=%#x\n",
+	    receive, done, count, last_irq | a5touch_read(hsi, 0x24),
+	    a5touch_read(hsi, 0x50), a5touch_read(hsi, 0x30));
+fail:
+	a5touch_write(hsi, 0x20, 0);
+	a5pmic_bus_init(hsi);
+	return false;
+}
+
+static bool
+a5pmic_read(vm_offset_t hsi, uint8_t reg, uint8_t *value)
+{
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		uint8_t address = reg;
+		if (a5pmic_message(hsi, false, &address, 1, false) &&
+		    a5pmic_message(hsi, true, value, 1, true)) {
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+static bool
+a5pmic_write(vm_offset_t hsi, uint8_t reg, uint8_t value)
+{
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		uint8_t data[2] = {reg, value};
+		if (a5pmic_message(hsi, false, data, 2, true)) {
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+static bool
+a5touch_power_on(vm_offset_t mifpins)
+{
+	vm_offset_t hsi = ml_io_map(0x104c0000, 0x2000);
+	uint32_t old_con;
+	uint32_t old_pud;
+	uint8_t id = 0xff;
+	uint8_t ldo = 0xff;
+	uint8_t check = 0xff;
+	if (!hsi) {
+		printf("A5XELTE TOUCH: PMIC HSI2C mapping failed\n");
+		return false;
+	}
+	old_con = a5touch_read(mifpins, 0);
+	old_pud = a5touch_read(mifpins, 8);
+	a5touch_write(mifpins, 8, (old_pud & ~0xfu) | 0xfu);
+	a5touch_write(mifpins, 0, (old_con & ~0xffu) | 0x22u);
+	delay(100);
+	a5pmic_bus_init(hsi);
+	if (!a5pmic_read(hsi, 0x00, &id) ||
+	    !a5pmic_read(hsi, 0x4e, &ldo)) {
+		printf("A5XELTE TOUCH: PMIC identity/control read failed\n");
+		goto fail;
+	}
+	printf("A5XELTE TOUCH: S2MPU03 ID=%#x LDO33=%#x\n", id, ldo);
+	/* Working Linux device read ID 0x02 and LDO33 0x3c before enable. */
+	if (id != 0x02 || (ldo & 0x3fu) != 0x3cu) {
+		printf("A5XELTE TOUCH: unexpected PMIC or LDO33 voltage, leave off\n");
+		goto fail;
+	}
+	if (!(ldo & 0xc0u)) {
+		if (!a5pmic_write(hsi, 0x4e, ldo | 0xc0u)) {
+			printf("A5XELTE TOUCH: LDO33 enable failed\n");
+			goto fail;
+		}
+	}
+	if (!a5pmic_read(hsi, 0x4e, &check) || check != (ldo | 0xc0u)) {
+		printf("A5XELTE TOUCH: LDO33 readback failed value=%#x\n", check);
+		goto fail;
+	}
+	printf("A5XELTE TOUCH: LDO33 enabled at 3.3 V, readback=%#x\n", check);
+	samsung_touch_hsi = hsi;
+	delay(15000);
+	return true;
+fail:
+	a5touch_write(mifpins, 0, old_con);
+	a5touch_write(mifpins, 8, old_pud);
+	return false;
+}
+
+/* S3C2440 I2C2: one bounded message, with STOP between Zinitix phases. */
+static bool
+a5touch_wait_irq(vm_offset_t i2c)
+{
+	for (unsigned n = 0; n < 20000; n++) {
+		if (a5touch_read(i2c, 0) & 0x10u) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+a5touch_clear_irq(vm_offset_t i2c)
+{
+	a5touch_write(i2c, 0, a5touch_read(i2c, 0) & ~0x10u);
+}
+
+static void
+a5touch_stop(vm_offset_t i2c)
+{
+	a5touch_write(i2c, 4, a5touch_read(i2c, 4) & ~0x20u);
+	a5touch_clear_irq(i2c);
+	for (unsigned n = 0; n < 5000; n++) {
+		if (!(a5touch_read(i2c, 4) & 0x20u)) {
+			break;
+		}
+		delay(1);
+	}
+}
+
+static bool
+a5touch_message(vm_offset_t i2c, bool receive, uint8_t *bytes, unsigned count)
+{
+	const uint32_t mode = receive ? 0x90u : 0xd0u;
+	bool ok = false;
+	if (!count || count > 34) {
+		return false;
+	}
+	for (unsigned n = 0; n < 5000; n++) {
+		if (!(a5touch_read(i2c, 4) & 0x20u)) {
+			break;
+		}
+		if (n == 4999) {
+			printf("A5XELTE TOUCH: I2C2 busy before message\n");
+			return false;
+		}
+		delay(1);
+	}
+	/* Conservative divider; the working Linux controller also sets ACK/IRQ. */
+	a5touch_write(i2c, 0, 0xe3u);
+	a5touch_write(i2c, 0x10, 7u); /* S3C2440 SDA delay/filter */
+	a5touch_write(i2c, 4, mode);
+	a5touch_write(i2c, 0xc, 0x40u | (receive ? 1u : 0u));
+	delay(1);
+	a5touch_write(i2c, 4, mode | 0x20u);
+	if (!a5touch_wait_irq(i2c)) {
+		printf("A5XELTE TOUCH: I2C2 address timeout stat=%#x con=%#x\n",
+		    a5touch_read(i2c, 4), a5touch_read(i2c, 0));
+		goto out;
+	}
+	if (a5touch_read(i2c, 4) & 1u) {
+		printf("A5XELTE TOUCH: I2C2 address NACK stat=%#x\n",
+		    a5touch_read(i2c, 4));
+		goto out;
+	}
+	for (unsigned n = 0; n < count; n++) {
+		if (receive) {
+			if (n + 1 == count) {
+				a5touch_write(i2c, 0, a5touch_read(i2c, 0) & ~0x80u);
+			}
+		} else {
+			a5touch_write(i2c, 0xc, bytes[n]);
+			delay(1);
+		}
+		a5touch_clear_irq(i2c);
+		if (!a5touch_wait_irq(i2c)) {
+			printf("A5XELTE TOUCH: I2C2 data timeout byte=%u stat=%#x\n",
+			    n, a5touch_read(i2c, 4));
+			goto out;
+		}
+		if (receive) {
+			bytes[n] = (uint8_t)a5touch_read(i2c, 0xc);
+		} else if (a5touch_read(i2c, 4) & 1u) {
+			printf("A5XELTE TOUCH: I2C2 data NACK byte=%u stat=%#x\n",
+			    n, a5touch_read(i2c, 4));
+			goto out;
+		}
+	}
+	ok = true;
+out:
+	a5touch_stop(i2c);
+	return ok;
+}
+
+static void
+a5touch_chip_code_trial(vm_offset_t nfc)
+{
+	vm_offset_t i2c = ml_io_map(0x13850000, 0x1000);
+	uint32_t old_con;
+	uint32_t old_pud;
+	uint8_t reg[2] = {0x00, 0xcc};
+	uint8_t code[2] = {0, 0};
+	bool sent;
+	bool got;
+	if (!i2c) {
+		printf("A5XELTE TOUCH: I2C2 mapping failed\n");
+		return;
+	}
+	old_con = a5touch_read(nfc, 0);
+	old_pud = a5touch_read(nfc, 8);
+	/* GPC3-0/1: Linux touch_bus function 2 and PUD 3; preserve other pins. */
+	a5touch_write(nfc, 8, (old_pud & ~0xfu) | 0xfu);
+	a5touch_write(nfc, 0, (old_con & ~0xffu) | 0x22u);
+	delay(100);
+	sent = a5touch_message(i2c, false, reg, sizeof(reg));
+	if (sent) {
+		delay(75); /* ZT7538 requires a STOP and 50 us before receive. */
+	}
+	got = sent && a5touch_message(i2c, true, code, sizeof(code));
+	printf("A5XELTE TOUCH: I2C2 chip-code sent=%d received=%d value=%#x stat=%#x con=%#x\n",
+	    sent, got, (unsigned)code[0] | ((unsigned)code[1] << 8),
+	    a5touch_read(i2c, 4), a5touch_read(i2c, 0));
+	a5touch_write(nfc, 0, old_con);
+	a5touch_write(nfc, 8, old_pud);
+}
+
+static bool
+a5touch_send(uint8_t *data, unsigned length)
+{
+	for (unsigned attempt = 0; attempt < 8; attempt++) {
+		if (a5touch_message(samsung_touch_bus, false, data, length)) {
+			return true;
+		}
+		delay(1100);
+	}
+	return false;
+}
+
+static bool
+a5touch_cmd(uint16_t reg)
+{
+	uint8_t data[2] = {(uint8_t)reg, (uint8_t)(reg >> 8)};
+	bool ok = a5touch_send(data, 2);
+	delay(20);
+	return ok;
+}
+
+static bool
+a5touch_write_reg(uint16_t reg, uint16_t value)
+{
+	uint8_t data[4] = {(uint8_t)reg, (uint8_t)(reg >> 8),
+	    (uint8_t)value, (uint8_t)(value >> 8)};
+	bool ok = a5touch_send(data, 4);
+	delay(20);
+	return ok;
+}
+
+static bool
+a5touch_read_reg(uint16_t reg, uint8_t *data, unsigned length)
+{
+	uint8_t address[2] = {(uint8_t)reg, (uint8_t)(reg >> 8)};
+	if (!a5touch_send(address, 2)) {
+		return false;
+	}
+	delay(75); /* The ZT7538 requires STOP then at least 50 us. */
+	if (!a5touch_message(samsung_touch_bus, true, data, length)) {
+		return false;
+	}
+	delay(20);
+	return true;
+}
+
+static bool
+a5touch_read_u16(uint16_t reg, uint16_t *value)
+{
+	uint8_t data[2] = {0, 0};
+	if (!a5touch_read_reg(reg, data, sizeof(data))) {
+		return false;
+	}
+	*value = a5touch_le16(data);
+	return true;
+}
+
+static void
+a5touch_sleep_5ms(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(5, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&samsung_touch_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+a5touch_recover(void)
+{
+	uint8_t ldo = 0;
+	uint8_t check = 0;
+	a5touch_release_contacts();
+	if (!samsung_touch_hsi || !a5pmic_read(samsung_touch_hsi, 0x4e, &ldo) ||
+	    (ldo & 0x3fu) != 0x3cu ||
+	    !a5pmic_write(samsung_touch_hsi, 0x4e, ldo & ~0xc0u)) {
+		printf("A5XELTE TOUCH: LDO33 recovery power-off failed\n");
+		return false;
+	}
+	delay(50000);
+	if (!a5pmic_write(samsung_touch_hsi, 0x4e, ldo | 0xc0u) ||
+	    !a5pmic_read(samsung_touch_hsi, 0x4e, &check) || check != (ldo | 0xc0u)) {
+		printf("A5XELTE TOUCH: LDO33 recovery power-on failed value=%#x\n", check);
+		return false;
+	}
+	delay(50000);
+	return a5touch_controller_init();
+}
+
+static void
+a5touch_log_thread(void *arg, wait_result_t result)
+{
+	unsigned lines = 0;
+	unsigned errors = 0;
+	unsigned idle_ticks = 0;
+	unsigned recoveries = 0;
+	(void)arg;
+	(void)result;
+	printf("A5XELTE TOUCH: contact HID worker started (GPA1-1)\n");
+	for (;;) {
+		/* ZT7538 holds INTN low until CLEAR_INT_STATUS. */
+		if (!(a5touch_read(samsung_touch_alive, 0x24) & 2u)) {
+			uint8_t packet[34] = {0};
+			bool read_ok = a5touch_read_reg(0x0080, packet, sizeof(packet));
+			bool ack_ok = a5touch_cmd(0x0003);
+			idle_ticks = 0;
+			if (!read_ok || !ack_ok ||
+			    (read_ok && ack_ok && !a5touch_report_packet(packet, &lines))) {
+				if (++errors <= 8) {
+					printf("A5XELTE TOUCH: packet/ACK failed read=%d ack=%d errors=%u\n",
+					    read_ok, ack_ok, errors);
+				}
+			} else {
+				errors = 0;
+			}
+		} else if (idle_ticks < 600) {
+			idle_ticks++;
+		}
+		if (errors >= 8 || idle_ticks >= 600) {
+			printf("A5XELTE TOUCH: recovery reason=%s attempt=%u\n",
+			    errors >= 8 ? "transfer" : "health IRQ", recoveries + 1);
+			if (!a5touch_recover() && ++recoveries >= 3) {
+				printf("A5XELTE TOUCH: worker stopped after recovery failures\n");
+				break;
+			}
+			errors = 0;
+			idle_ticks = 0;
+		}
+		a5touch_sleep_5ms();
+	}
+	a5touch_release_contacts();
+	thread_terminate_self();
+}
+
+static void
+a5touch_release_contacts(void)
+{
+	for (unsigned slot = 0; slot < 5; slot++) {
+		if (samsung_touch_active[slot]) {
+			sweet_hid_touch(slot, 0, samsung_touch_x[slot], samsung_touch_y[slot]);
+			samsung_touch_active[slot] = false;
+		}
+	}
+}
+
+/* Native Linux mode-0 packet policy, followed by the existing iOS HID
+ * digitizer service.  A heartbeat leaves all slots unchanged. */
+static bool
+a5touch_report_packet(const uint8_t packet[34], unsigned *lines)
+{
+	uint16_t status = a5touch_le16(packet);
+	unsigned count = packet[2];
+	if (status == 0) {
+		return true;
+	}
+	if (status == 0xffffu || status == 1u || (status & (1u << 13)) || count > 5) {
+		printf("A5XELTE TOUCH: corrupt packet status=%#x count=%u\n", status, count);
+		return false;
+	}
+	for (unsigned slot = 0; slot < 5; slot++) {
+		unsigned at = 4 + 6 * slot;
+		uint16_t x = a5touch_le16(packet + at);
+		uint16_t y = a5touch_le16(packet + at + 2);
+		unsigned sub = packet[at + 5];
+		bool active = (status & (1u << 11)) && !(status & 0x30u) &&
+		    (sub & 1u) && !(sub & 8u) && x <= 1080 && y <= 1920;
+		if (active) {
+			if (*lines < 256 && (!samsung_touch_active[slot] ||
+			    samsung_touch_x[slot] != x || samsung_touch_y[slot] != y)) {
+				printf("A5XELTE TOUCH: contact slot=%u x=%u y=%u width=%u flags=%#x status=%#x\n",
+				    slot, x, y, packet[at + 4], sub, status);
+				(*lines)++;
+			}
+			samsung_touch_x[slot] = x;
+			samsung_touch_y[slot] = y;
+			samsung_touch_active[slot] = true;
+			sweet_hid_touch(slot, 1, x, y);
+		} else if (samsung_touch_active[slot]) {
+			sweet_hid_touch(slot, 0, samsung_touch_x[slot], samsung_touch_y[slot]);
+			samsung_touch_active[slot] = false;
+		}
+	}
+	return true;
+}
+
+static bool
+a5touch_controller_init(void)
+{
+	uint16_t chip = 0;
+	uint16_t crc = 0;
+	uint16_t x = 0;
+	uint16_t y = 0;
+	/* Native ZT7538 power-on sequence; abort on each failed transfer. */
+	if (!a5touch_write_reg(0xc000, 1) ||
+	    !a5touch_read_u16(0xcc00, &chip) || chip != 0xe538) {
+		printf("A5XELTE TOUCH: chip-code failed value=%#x\n", chip);
+		goto fail;
+	}
+	printf("A5XELTE TOUCH: ZT7538 chip-code=%#x\n", chip);
+	if (!a5touch_cmd(0xc004) || !a5touch_write_reg(0xc002, 1)) {
+		printf("A5XELTE TOUCH: firmware init sequence failed\n");
+		goto fail;
+	}
+	delay(2000);
+	if (!a5touch_write_reg(0xc001, 1)) {
+		printf("A5XELTE TOUCH: program start failed\n");
+		goto fail;
+	}
+	delay(150000);
+	if (!a5touch_read_u16(0x012c, &crc) || crc != 0x55aau ||
+	    !a5touch_read_u16(0x00c0, &x) || !a5touch_read_u16(0x00c1, &y)) {
+		printf("A5XELTE TOUCH: firmware CRC/geometry failed crc=%#x x=%u y=%u\n",
+		    crc, x, y);
+		goto fail;
+	}
+	printf("A5XELTE TOUCH: firmware CRC=%#x geometry=%ux%u\n", crc, x, y);
+	if (!a5touch_cmd(0x0000) || !a5touch_write_reg(0x00f0, 0) ||
+	    !a5touch_write_reg(0x0010, 0) ||
+	    !a5touch_write_reg(0x00f0, 0x003f)) {
+		printf("A5XELTE TOUCH: mode 0 setup failed\n");
+		goto fail;
+	}
+	for (unsigned n = 0; n < 10; n++) {
+		if (!a5touch_cmd(0x0003)) {
+			printf("A5XELTE TOUCH: interrupt queue ACK failed\n");
+			goto fail;
+		}
+	}
+	if (!a5touch_write_reg(0x00f1, 100)) {
+		printf("A5XELTE TOUCH: heartbeat setup failed\n");
+		goto fail;
+	}
+	printf("A5XELTE TOUCH: mode 0 ready, INTN=%u\n",
+	    (unsigned)!!(a5touch_read(samsung_touch_alive, 0x24) & 2u));
+	return true;
+fail:
+	return false;
+}
+
+static void
+a5touch_start_early(vm_offset_t nfc, vm_offset_t alive)
+{
+	uint32_t con;
+	uint32_t pud;
+	thread_t thread;
+	samsung_touch_bus = ml_io_map(0x13850000, 0x1000);
+	samsung_touch_alive = alive;
+	if (!samsung_touch_bus) {
+		printf("A5XELTE TOUCH: I2C2 mapping failed\n");
+		return;
+	}
+	con = a5touch_read(nfc, 0);
+	pud = a5touch_read(nfc, 8);
+	a5touch_write(nfc, 8, (pud & ~0xfu) | 0xfu);
+	a5touch_write(nfc, 0, (con & ~0xffu) | 0x22u);
+	delay(100);
+	if (!a5touch_controller_init()) {
+		a5touch_write(nfc, 0, con);
+		a5touch_write(nfc, 8, pud);
+		return;
+	}
+	if (kernel_thread_start(a5touch_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("A5XELTE TOUCH: contact thread start failed\n");
+	}
+}
+
+#if defined(DREAMLTE)
+/*
+ * Galaxy S8 I2C devices, polled (no XNU interrupt routing for them).
+ * The loader (shim/dreamlte) ungates both USI blocks with their clock on
+ * OSCCLK, sets USI v1 I2C mode and the pins, and powers the touch rails.
+ *
+ * Touch: Samsung S6SY761 at 0x48 on hsi2c_23 (USI09, 0x108e0000), its
+ * interrupt gpa1-0 active low (boot 26: boot status 0x20, device id
+ * 0xac3761). Event protocol from mainline s6sy761.c; raw 0..4095 axes go
+ * to SweetHIDTouch's 1080x1920 grid.
+ *
+ * Battery: MAX77865 on hsi2c_32 (USI13 second HSI2C, 0x10970000), fuel
+ * gauge 0x36 and charger 0x69 (Samsung max77865_fuelgauge.c/_charger.c).
+ */
+#define S8TS_HSI2C_PA           0x108e0000u
+#define S8BAT_HSI2C_PA          0x10970000u
+#define S8TS_ALIVE_PA           0x164b0000u
+#define S8TS_GPA1_DAT           0x44u
+#define S8TS_ADDR               0x48u
+#define S8BAT_FG                0x36u
+#define S8BAT_CHG               0x69u
+#define S8TS_FINGERS            10
+#define S8_I2C_CLKIN            26000000u
+#define S8_I2C_SCL_HZ           400000u
+
+static vm_offset_t s8ts_i2c, s8ts_alive, s8bat_i2c;
+static int s8ts_sleep;
+static int s8ts_native;         /* sweetfb_native: iOS sees the whole panel */
+static bool s8ts_down[S8TS_FINGERS];
+static uint16_t s8ts_x[S8TS_FINGERS], s8ts_y[S8TS_FINGERS];
+
+/* i2c-exynos5.c: reset, Exynos8895 fast-mode timing, master auto mode. */
+static void
+s8i2c_reset(vm_offset_t bus)
+{
+	a5touch_write(bus, 0x00, a5touch_read(bus, 0x00) | (1u << 31));
+	a5touch_write(bus, 0x00, a5touch_read(bus, 0x00) & ~(1u << 31));
+	unsigned ftl = (a5touch_read(bus, 0x40) >> 16) & 7;
+	unsigned temp = S8_I2C_CLKIN / S8_I2C_SCL_HZ - (ftl + 3) * 2;
+	unsigned div = temp / 512;
+	unsigned cyc = (temp + ((ftl + 3) % (div + 1)) * 2) / (div + 1) - 2;
+	unsigned l = cyc * 64 / 100, h = cyc - l;
+	a5touch_write(bus, 0x60, l << 24 | l << 16 | l << 8);
+	a5touch_write(bus, 0x64, (l / 2) << 24 | l << 8 | h);
+	a5touch_write(bus, 0x68, div << 16 | cyc);
+	a5touch_write(bus, 0x6c, l / 2);
+	a5touch_write(bus, 0x48, a5touch_read(bus, 0x48) & ~(1u << 31));
+	a5touch_write(bus, 0x00, 0x9);
+	a5touch_write(bus, 0x08, 0xf);
+	a5touch_write(bus, 0x40, a5touch_read(bus, 0x40) | (1u << 31));
+}
+
+/* INT_STATUS: bit 7 TRANS_DONE, bits 8-11 abort/no-ack/no-dev/timeout. */
+static bool
+s8i2c_wait_done(vm_offset_t bus)
+{
+	for (unsigned us = 0; us < 20000; us++) {
+		uint32_t s = a5touch_read(bus, 0x24);
+		if (s & 0xf80u) {
+			a5touch_write(bus, 0x24, s);
+			return !(s & 0xf00u);
+		}
+		delay(1);
+	}
+	return false;
+}
+
+/* Write wlen bytes, then read rlen bytes (repeated start); STOP at the end. */
+static bool
+s8i2c_xfer(vm_offset_t bus, unsigned addr, const uint8_t *w, unsigned wlen,
+    uint8_t *r, unsigned rlen)
+{
+	a5touch_write(bus, 0x24, a5touch_read(bus, 0x24));
+	a5touch_write(bus, 0x70, addr << 10);
+	a5touch_write(bus, 0x20, 0xf80u);
+	if (wlen) {
+		a5touch_write(bus, 0x04, 3);
+		a5touch_write(bus, 0x00, 0x9 | 0x80);
+		a5touch_write(bus, 0x44, (rlen ? 0 : (1u << 17)) | wlen | (1u << 31));
+		for (unsigned i = 0; i < wlen; i++) {
+			for (unsigned n = 0; n < 1000 && (a5touch_read(bus, 0x30) & (1u << 7)); n++) {
+				delay(1);
+			}
+			a5touch_write(bus, 0x34, w[i]);
+		}
+		if (!s8i2c_wait_done(bus)) {
+			goto fail;
+		}
+	}
+	if (rlen) {
+		a5touch_write(bus, 0x04, 3);
+		a5touch_write(bus, 0x00, 0x9 | 0x40);
+		a5touch_write(bus, 0x44, (1u << 16) | (1u << 17) | rlen | (1u << 31));
+		for (unsigned i = 0; i < rlen; i++) {
+			unsigned n = 0;
+			while ((a5touch_read(bus, 0x30) & (1u << 24)) && n++ < 20000) {
+				delay(1);
+			}
+			if (a5touch_read(bus, 0x30) & (1u << 24)) {
+				goto fail;
+			}
+			r[i] = (uint8_t)a5touch_read(bus, 0x38);
+		}
+		if (!s8i2c_wait_done(bus)) {
+			goto fail;
+		}
+	}
+	a5touch_write(bus, 0x00, 0x9);
+	return true;
+fail:
+	s8i2c_reset(bus);
+	return false;
+}
+
+static bool
+s8ts_cmd_read(uint8_t cmd, uint8_t *r, unsigned rlen)
+{
+	return s8i2c_xfer(s8ts_i2c, S8TS_ADDR, &cmd, 1, r, rlen);
+}
+
+static void
+s8ts_report(const uint8_t *ev)
+{
+	if ((ev[0] & 3) != 0 || !(ev[0] & 0x3c)) {
+		return;         /* status/info event, or no touch id */
+	}
+	unsigned tid = ((ev[0] & 0x3cu) >> 2) - 1;
+	unsigned state = (ev[0] & 0xc0u) >> 6;
+	if (tid >= S8TS_FINGERS) {
+		return;
+	}
+	unsigned x = ((unsigned)ev[1] << 4) | (ev[3] >> 4);
+	unsigned y = ((unsigned)ev[2] << 4) | (ev[3] & 0xf);
+	if (s8ts_native) {
+		x = x * 1080 / 4096;
+		y = y * 1920 / 4096;
+	} else {
+		/* 1125x2436 is shown centered on the 1440x2960 panel. */
+		int px = (int)(x * 1440 / 4096) - (1440 - 1125) / 2;
+		int py = (int)(y * 2960 / 4096) - (2960 - 2436) / 2;
+		px = px < 0 ? 0 : (px > 1124 ? 1124 : px);
+		py = py < 0 ? 0 : (py > 2435 ? 2435 : py);
+		x = (unsigned)px * 1080 / 1125;
+		y = (unsigned)py * 1920 / 2436;
+	}
+	if (state == 1 || state == 2) {             /* press, move */
+		if (!s8ts_down[tid]) {
+			printf("S8 TOUCH: down id=%u x=%u y=%u\n", tid, x, y);
+		}
+		s8ts_down[tid] = true;
+		s8ts_x[tid] = (uint16_t)x;
+		s8ts_y[tid] = (uint16_t)y;
+		if (tid < 5) {
+			sweet_hid_touch((int)tid, 1, (int)x, (int)y);
+		}
+	} else if (state == 3 && s8ts_down[tid]) { /* release */
+		s8ts_down[tid] = false;
+		if (tid < 5) {
+			sweet_hid_touch((int)tid, 0, s8ts_x[tid], s8ts_y[tid]);
+		}
+	}
+}
+
+static void
+s8ts_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&s8ts_sleep, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+s8ts_thread(void *arg, wait_result_t result)
+{
+	uint8_t buf[8 * 32];
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	printf("S8 TOUCH: worker started\n");
+	for (;;) {
+		/* INT is level low while events are queued. */
+		if (a5touch_read(s8ts_alive, S8TS_GPA1_DAT) & 1u) {
+			s8ts_wait(8);
+			continue;
+		}
+		if (!s8ts_cmd_read(0x60, buf, 8)) {         /* READ_ONE_EVENT */
+			if (++errors <= 8 || !(errors & 255)) {
+				printf("S8 TOUCH: event read failed (%u)\n", errors);
+			}
+			s8ts_wait(20);
+			continue;
+		}
+		unsigned left = buf[7] & 0x3fu;
+		if (buf[0] && left && left < 32 &&
+		    !s8ts_cmd_read(0x61, buf + 8, left * 8)) {   /* READ_ALL_EVENT */
+			left = 0;
+		}
+		if (!buf[0]) {
+			s8ts_wait(4);       /* INT low with an empty queue */
+			continue;
+		}
+		for (unsigned i = 0; i <= left; i++) {
+			if (buf[i * 8]) {
+				s8ts_report(buf + i * 8);
+			}
+		}
+		errors = 0;
+	}
+}
+
+static bool
+s8bat_read16(unsigned addr, uint8_t reg, uint16_t *value)
+{
+	uint8_t b[2];
+	if (!s8i2c_xfer(s8bat_i2c, addr, &reg, 1, b, 2)) {
+		return false;
+	}
+	*value = (uint16_t)(b[0] | (b[1] << 8));
+	return true;
+}
+
+/*
+ * SweetBattery (patch 0124) calls this every 30 s. 0 = valid sample.
+ * MAX77865 fuel gauge: SOCREP 0x06 in 1/256 %, VCELL 0x09 in 78.125 uV,
+ * CURRENT 0x0a signed 156.25 uA (0.01 ohm sense, positive = charging).
+ * Charger: INT_OK 0xb2 bit 6 CHGIN_OK; DETAILS_01 0xb4 [3:0] 0-2 charging,
+ * 3-4 done.
+ */
+int dreamlte_battery_read(unsigned *percent, unsigned *mv, int *ma,
+    int *external, int *charging, int *full);
+int
+dreamlte_battery_read(unsigned *percent, unsigned *mv, int *ma,
+    int *external, int *charging, int *full)
+{
+	uint16_t soc, vcell, cur;
+	uint8_t reg, ok = 0, dtls = 0;
+	if (!s8bat_i2c) {
+		s8bat_i2c = ml_io_map(S8BAT_HSI2C_PA, 0x1000);
+		if (!s8bat_i2c) {
+			return -1;
+		}
+		s8i2c_reset(s8bat_i2c);
+	}
+	if (!s8bat_read16(S8BAT_FG, 0x06, &soc) || !s8bat_read16(S8BAT_FG, 0x09, &vcell) ||
+	    !s8bat_read16(S8BAT_FG, 0x0a, &cur)) {
+		return -1;
+	}
+	reg = 0xb2;
+	(void)s8i2c_xfer(s8bat_i2c, S8BAT_CHG, &reg, 1, &ok, 1);
+	reg = 0xb4;
+	(void)s8i2c_xfer(s8bat_i2c, S8BAT_CHG, &reg, 1, &dtls, 1);
+	unsigned pct = (unsigned)(soc >> 8) + ((soc & 0xffu) >= 128 ? 1 : 0);
+	*percent = pct > 100 ? 100 : pct;
+	*mv = (unsigned)((uint32_t)vcell * 78125u / 1000000u);
+	*ma = (int)((int16_t)cur) * 15625 / 100000;
+	*external = (ok & 0x40u) != 0;
+	dtls &= 0x0f;
+	*charging = *external && dtls <= 2;
+	*full = *external && (dtls == 3 || dtls == 4);
+	return (*mv >= 2800 && *mv <= 4600) ? 0 : -1;
+}
+
+static void
+dreamlte_touch_start(void)
+{
+	uint8_t b[11] = {0};
+	thread_t thread;
+	int enabled = 1;
+	(void)PE_parse_boot_argn("s8touch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweetfb_native", &s8ts_native, sizeof(s8ts_native));
+	if (!enabled) {
+		printf("S8 TOUCH: disabled\n");
+		return;
+	}
+	s8ts_i2c = ml_io_map(S8TS_HSI2C_PA, 0x1000);
+	s8ts_alive = ml_io_map(S8TS_ALIVE_PA, 0x1000);
+	if (!s8ts_i2c || !s8ts_alive) {
+		printf("S8 TOUCH: MMIO mapping failed\n");
+		return;
+	}
+	s8i2c_reset(s8ts_i2c);
+	if (!s8ts_cmd_read(0x55, b, 1) || b[0] != 0x20) {     /* BOOT_STATUS */
+		printf("S8 TOUCH: no S6SY761 in application mode (status %#x)\n", b[0]);
+		return;
+	}
+	if (s8ts_cmd_read(0x52, b, 3)) {                       /* DEVICE_ID */
+		printf("S8 TOUCH: S6SY761 id %02x%02x%02x\n", b[0], b[1], b[2]);
+	}
+	uint8_t func[3] = {0x30, 0x01, 0x00};                  /* TOUCH_FUNCTION = touch */
+	uint8_t sense = 0x10;                                   /* SENSE_ON */
+	if (!s8i2c_xfer(s8ts_i2c, S8TS_ADDR, func, 3, NULL, 0) ||
+	    !s8i2c_xfer(s8ts_i2c, S8TS_ADDR, &sense, 1, NULL, 0)) {
+		printf("S8 TOUCH: enable sequence failed\n");
+		return;
+	}
+	if (kernel_thread_start(s8ts_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("S8 TOUCH: thread start failed\n");
+	}
+}
+#endif /* DREAMLTE */
+
+void
+samsung_touch_probe(void)
+{
+#if defined(DREAMLTE)
+	dreamlte_touch_start();   /* the A5 path below stays off */
+#endif
+	int enabled = SWEET_TOUCH_DEFAULT; /* A5 touch: off on the S8 */
+	int log_contacts = 0;
+	int bus_trial = 0;
+	vm_offset_t alive;
+	vm_offset_t nfc;
+	vm_offset_t mifpins;
+	vm_offset_t peri;
+	vm_offset_t mif;
+	uint32_t pclk;
+	uint32_t mifclk;
+	(void)PE_parse_boot_argn("a5touchprobe", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("a5touchlog", &log_contacts, sizeof(log_contacts));
+	if (!enabled) {
+		return;
+	}
+	alive = ml_io_map(0x139b0000, 0x1000);
+	nfc = ml_io_map(0x138c0000, 0x1000);
+	mifpins = ml_io_map(0x104e0000, 0x1000);
+	peri = ml_io_map(0x139f0000, 0x1000);
+	mif = ml_io_map(0x10430000, 0x1000);
+	if (!alive || !nfc || !mifpins || !peri || !mif) {
+		printf("A5XELTE TOUCH: probe MMIO mapping failed\n");
+		return;
+	}
+	pclk = a5touch_read(peri, 0x904);
+	mifclk = a5touch_read(mif, 0x900);
+	printf("A5XELTE TOUCH: INT GPA1 con=%#x dat=%#x; GPC3 con=%#x dat=%#x pud=%#x\n",
+	    a5touch_read(alive, 0x20), a5touch_read(alive, 0x24),
+	    a5touch_read(nfc, 0), a5touch_read(nfc, 4), a5touch_read(nfc, 8));
+	printf("A5XELTE TOUCH: I2C2 gate=%d MIF HSI2C3 gate=%d GPM0 con=%#x dat=%#x pud=%#x\n",
+	    !!(pclk & (1u << 9)), !!(mifclk & (1u << 27)),
+	    a5touch_read(mifpins, 0), a5touch_read(mifpins, 4),
+	    a5touch_read(mifpins, 8));
+	if (pclk & (1u << 9)) {
+		vm_offset_t i2c = ml_io_map(0x13850000, 0x1000);
+		if (i2c) {
+			printf("A5XELTE TOUCH: I2C2 con=%#x stat=%#x add=%#x lc=%#x (read only)\n",
+			    a5touch_read(i2c, 0), a5touch_read(i2c, 4),
+			    a5touch_read(i2c, 8), a5touch_read(i2c, 0x10));
+		}
+		(void)PE_parse_boot_argn("a5touchbus", &bus_trial, sizeof(bus_trial));
+		if (log_contacts && (mifclk & (1u << 27))) {
+			if (a5touch_power_on(mifpins)) {
+				a5touch_start_early(nfc, alive);
+			}
+		} else if (bus_trial) {
+			a5touch_chip_code_trial(nfc);
+		}
+	}
+}
+#endif
